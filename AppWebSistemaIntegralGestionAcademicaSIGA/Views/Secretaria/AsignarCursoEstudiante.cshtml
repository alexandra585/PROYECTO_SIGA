@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.AsignacionCursoEstudianteViewModel

@{
    ViewData["Title"] = "Matrícula curso - estudiante";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">

        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

            <div>

                <p class="text-sm font-medium text-blue-100">
                    Matrícula académica
                </p>

                <h2 class="mt-2 text-3xl font-extrabold">
                    Matricular curso - estudiante
                </h2>

                <p class="mt-3 max-w-2xl text-blue-100">
                    Matricula estudiantes en cursos previamente asignados a docentes.
                </p>

            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="user-check" class="h-8 w-8"></i>
            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJE DE ÉXITO -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">

            <div class="flex items-start gap-3">

                <i data-lucide="check-circle-2"
                   class="mt-0.5 h-5 w-5">
                </i>

                <p class="text-sm font-semibold">
                    @TempData["Success"]
                </p>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MENSAJE DE ERROR -->
    <!-- ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">

            <div class="flex items-start gap-3">

                <i data-lucide="x-circle"
                   class="mt-0.5 h-5 w-5">
                </i>

                <p class="text-sm font-semibold">
                    @TempData["Error"]
                </p>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ACCIONES -->
    <!-- ========================================================= -->

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">

        <a asp-action="ListAsignarCursoEstudiante"
           asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">

            <i data-lucide="list" class="h-4 w-4"></i>

            Listado de matrículas

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="grid gap-6 lg:grid-cols-3">


        <!-- ===================================================== -->
        <!-- RESUMEN -->
        <!-- ===================================================== -->

        <div class="flex min-h-[600px] flex-col rounded-3xl border border-slate-200 bg-white shadow-sm lg:col-span-2">

            <!-- CABECERA -->

            <div class="border-b border-slate-200 px-6 py-5">

                <div class="flex items-center justify-between gap-4">

                    <div>

                        <h3 class="text-lg font-bold text-slate-950">
                            Resumen de la matrícula
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Revisa los datos seleccionados antes de confirmar.
                        </p>

                    </div>

                    <div id="estadoResumen"
                         class="hidden rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">

                        Lista para confirmar

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ESTADO VACÍO -->
            <!-- ================================================= -->

            <div id="resumenVacio"
                 class="flex min-h-[400px] flex-col items-center justify-center px-6 py-12 text-center">

                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">

                    <i data-lucide="graduation-cap"
                       class="h-8 w-8">
                    </i>

                </div>

                <h4 class="mt-5 text-lg font-bold text-slate-900">
                    Nueva matrícula
                </h4>

                <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
                    Selecciona el curso y el estudiante para comenzar
                    con la matrícula.
                </p>

                <button type="button"
                        onclick="abrirModalMatricula()"
                        class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                    <i data-lucide="plus"
                       class="h-4 w-4">
                    </i>

                    Seleccionar datos

                </button>

            </div>


            <!-- ================================================= -->
            <!-- RESUMEN SELECCIONADO -->
            <!-- ================================================= -->

            <div id="resumenMatricula"
                 class="hidden flex flex-1 flex-col p-6">

                <div class="grid gap-4">


                    <!-- ================================================= -->
                    <!-- CURSO -->
                    <!-- ================================================= -->

                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">

                        <div class="flex items-start gap-4">

                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-600">

                                <i data-lucide="book-open"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <div class="min-w-0">

                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                    Curso
                                </p>

                                <p id="resumenCursoNombre"
                                   class="mt-1 truncate text-base font-bold text-slate-900">
                                </p>

                                <p id="resumenCursoDocente"
                                   class="mt-1 text-sm text-slate-500">
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ESTUDIANTE -->
                    <!-- ================================================= -->

                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">

                        <div class="flex items-start gap-4">

                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600">

                                <i data-lucide="graduation-cap"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <div class="min-w-0">

                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                    Estudiante
                                </p>

                                <p id="resumenEstudianteNombre"
                                   class="mt-1 truncate text-base font-bold text-slate-900">
                                </p>

                                <p id="resumenEstudianteCodigo"
                                   class="mt-1 text-sm text-slate-500">
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- AVISO -->
                <!-- ================================================= -->

                <div class="mt-5 flex items-start gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 text-blue-800">

                    <i data-lucide="info"
                       class="mt-0.5 h-5 w-5 shrink-0">
                    </i>

                    <p class="text-sm leading-6">
                        Verifica que el curso, docente y estudiante sean
                        correctos antes de confirmar la matrícula.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- FORMULARIO FINAL -->
                <!-- ================================================= -->

                <form asp-action="AsignarCursoEstudiante"
                      asp-controller="Secretaria"
                      method="post"
                      id="formConfirmarMatricula"
                      class="mt-auto pt-6">

                    @Html.AntiForgeryToken()

                    <!-- VALORES QUE SE ENVIARÁN AL CONTROLLER -->

                    <input type="hidden"
                           id="cursoDocenteId"
                           name="cursoDocenteId" />

                    <input type="hidden"
                           id="alumnoId"
                           name="alumnoId" />


                    <div class="flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:justify-end">

                        <button type="button"
                                onclick="abrirModalMatricula()"
                                class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">

                            <i data-lucide="pencil"
                               class="h-4 w-4">
                            </i>

                            Cambiar selección

                        </button>


                        <button type="button"
                                onclick="cancelarMatricula()"
                                class="inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 bg-white px-5 py-3 text-sm font-semibold text-red-600 transition hover:bg-red-50">

                            <i data-lucide="x"
                               class="h-4 w-4">
                            </i>

                            Cancelar

                        </button>


                        <button type="submit"
                                class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                            <i data-lucide="check"
                               class="h-4 w-4">
                            </i>

                            Confirmar matrícula

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- INFORMACIÓN -->
        <!-- ===================================================== -->

        <div class="space-y-6">


            <!-- INFORMACIÓN -->

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                    <i data-lucide="info"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Información
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Esta acción registra al estudiante dentro del curso
                    previamente asignado a un docente.
                </p>

            </div>


            <!-- RECOMENDACIÓN -->

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">

                    <i data-lucide="shield-check"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Recomendación
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Verifica que el estudiante corresponda al curso
                    seleccionado antes de confirmar.
                </p>

            </div>


            <!-- CONFIRMACIÓN -->

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">

                    <i data-lucide="check-check"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Confirmación
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Los datos no se guardarán hasta que confirmes
                    la matrícula desde el resumen.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ============================================================= -->
<!-- MODAL -->
<!-- ============================================================= -->

<div id="modalMatricula"
     class="fixed inset-0 z-50 hidden">


    <!-- FONDO -->

    <div class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm"
         onclick="cerrarModalMatricula()">
    </div>


    <!-- CONTENEDOR -->

    <div class="relative flex min-h-full items-center justify-center p-4">

        <div class="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5">

                <div>

                    <div class="flex items-center gap-3">

                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                            <i data-lucide="user-check"
                               class="h-5 w-5">
                            </i>

                        </div>

                        <div>

                            <h3 class="text-lg font-bold text-slate-950">
                                Seleccionar matrícula
                            </h3>

                            <p class="mt-1 text-sm text-slate-500">
                                Busca y selecciona el curso y estudiante.
                            </p>

                        </div>

                    </div>

                </div>


                <button type="button"
                        onclick="cerrarModalMatricula()"
                        class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">

                    <i data-lucide="x"
                       class="h-5 w-5">
                    </i>

                </button>

            </div>


            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <div class="max-h-[75vh] overflow-y-auto p-6">

                <div class="space-y-5">


                    <!-- ================================================= -->
                    <!-- CURSO -->
                    <!-- ================================================= -->

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Curso
                        </label>

                        <div class="relative">

                            <i data-lucide="book-open"
                               class="absolute left-4 top-3.5 h-5 w-5 text-slate-400">
                            </i>

                            <input type="text"
                                   id="buscarCurso"
                                   placeholder="Buscar por curso o docente..."
                                   autocomplete="off"
                                   oninput="filtrarCursos()"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        </div>


                        <!-- SELECCIONADO -->

                        <div id="cursoSeleccionado"
                             class="mt-3 hidden rounded-xl border border-blue-200 bg-blue-50 p-3">

                            <div class="flex items-center justify-between">

                                <div class="flex items-center gap-3">

                                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600">

                                        <i data-lucide="book-open"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div>

                                        <p id="cursoSeleccionadoNombre"
                                           class="text-sm font-bold text-slate-800">
                                        </p>

                                        <p id="cursoSeleccionadoDocente"
                                           class="text-xs text-slate-500">
                                        </p>

                                    </div>

                                </div>


                                <button type="button"
                                        onclick="limpiarCurso()"
                                        class="text-slate-400 transition hover:text-red-500">

                                    <i data-lucide="x"
                                       class="h-4 w-4">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <!-- RESULTADOS -->

                        <div id="resultadosCursos"
                             class="mt-2 hidden max-h-48 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg">


                            <!-- SIN RESULTADOS -->

                            <div id="sinResultadosCursos"
                                 class="hidden px-4 py-6 text-center text-sm text-slate-500">

                                <div class="flex flex-col items-center justify-center">

                                    <i data-lucide="search-x"
                                       class="mb-2 h-6 w-6 text-slate-400">
                                    </i>

                                    <p class="font-medium">
                                        No se encontraron cursos
                                    </p>

                                    <p class="mt-1 text-xs text-slate-400">
                                        Intenta buscar por otro curso o docente.
                                    </p>

                                </div>

                            </div>


                            <!-- CURSOS -->
                            @foreach (var curso in Model.CursoDocente)
                            {
                                <button type="button"
                                        class="curso-item flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition last:border-0 hover:bg-blue-50"
                                        data-id="@curso.id"
                                        data-nombre="@curso.nombreCurso"
                                        data-docente="@curso.nombreDocente"
                                        onclick="seleccionarCurso(this)">

                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                        <i data-lucide="book-open"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div class="min-w-0">

                                        <p class="truncate text-sm font-semibold text-slate-800">
                                            @curso.nombreCurso
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Docente: @curso.nombreDocente
                                        </p>

                                    </div>

                                </button>
                            }

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ESTUDIANTE -->
                    <!-- ================================================= -->

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Estudiante
                        </label>

                        <div class="relative">

                            <i data-lucide="graduation-cap"
                               class="absolute left-4 top-3.5 h-5 w-5 text-slate-400">
                            </i>

                            <input type="text"
                                   id="buscarEstudiante"
                                   placeholder="Buscar por nombre o código..."
                                   autocomplete="off"
                                   oninput="filtrarEstudiantes()"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        </div>


                        <!-- SELECCIONADO -->

                        <div id="estudianteSeleccionado"
                             class="mt-3 hidden rounded-xl border border-indigo-200 bg-indigo-50 p-3">

                            <div class="flex items-center justify-between">

                                <div class="flex items-center gap-3">

                                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">

                                        <i data-lucide="graduation-cap"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div>

                                        <p id="estudianteSeleccionadoNombre"
                                           class="text-sm font-bold text-slate-800">
                                        </p>

                                        <p id="estudianteSeleccionadoCodigo"
                                           class="text-xs text-slate-500">
                                        </p>

                                    </div>

                                </div>


                                <button type="button"
                                        onclick="limpiarEstudiante()"
                                        class="text-slate-400 transition hover:text-red-500">

                                    <i data-lucide="x"
                                       class="h-4 w-4">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <!-- RESULTADOS -->

                        <div id="resultadosEstudiantes"
                             class="mt-2 hidden max-h-48 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg">


                            <!-- SIN RESULTADOS -->

                            <div id="sinResultadosEstudiantes"
                                 class="hidden px-4 py-6 text-center text-sm text-slate-500">

                                <div class="flex flex-col items-center justify-center">

                                    <i data-lucide="search-x"
                                       class="mb-2 h-6 w-6 text-slate-400">
                                    </i>

                                    <p class="font-medium">
                                        No se encontraron estudiantes
                                    </p>

                                    <p class="mt-1 text-xs text-slate-400">
                                        Intenta buscar por otro nombre o código.
                                    </p>

                                </div>

                            </div>


                            <!-- ESTUDIANTES -->
                            @foreach (var alumno in Model.Estudiantes)
                            {
                                <button type="button"
                                        class="estudiante-item flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition last:border-0 hover:bg-indigo-50"
                                        data-id="@alumno.id"
                                        data-nombre="@alumno.nombreCompleto"
                                        data-codigo="@alumno.codigoEstudiante"
                                        onclick="seleccionarEstudiante(this)">

                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                        <i data-lucide="graduation-cap"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div class="min-w-0">

                                        <p class="truncate text-sm font-semibold text-slate-800">
                                            @alumno.nombreCompleto
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Código: @alumno.codigoEstudiante
                                        </p>

                                    </div>

                                </button>
                            }

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ERROR -->
                    <!-- ================================================= -->

                    <div id="errorModal"
                         class="hidden rounded-xl border border-red-200 bg-red-50 p-4">

                        <div class="flex items-start gap-3">

                            <i data-lucide="alert-circle"
                               class="mt-0.5 h-5 w-5 shrink-0 text-red-500">
                            </i>

                            <p id="mensajeErrorModal"
                               class="text-sm font-medium text-red-700">
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <div class="flex flex-col gap-3 border-t border-slate-200 px-6 py-5 sm:flex-row sm:justify-end">

                <button type="button"
                        onclick="cerrarModalMatricula()"
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">

                    <i data-lucide="x"
                       class="h-4 w-4">
                    </i>

                    Cancelar

                </button>


                <button type="button"
                        onclick="continuarMatricula()"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">

                    Continuar

                    <i data-lucide="arrow-right"
                       class="h-4 w-4">
                    </i>

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    // =========================================================
    // VARIABLES
    // =========================================================

    let cursoSeleccionadoId = "";
    let estudianteSeleccionadoId = "";


    // =========================================================
    // MODAL
    // =========================================================

    function abrirModalMatricula() {

        document
            .getElementById("modalMatricula")
            .classList
            .remove("hidden");

        document.body.classList.add("overflow-hidden");

        restaurarSeleccion();

    }


    function cerrarModalMatricula() {

        document
            .getElementById("modalMatricula")
            .classList
            .add("hidden");

        document.body.classList.remove("overflow-hidden");

        ocultarError();

    }


    // =========================================================
    // CURSOS
    // =========================================================

    function filtrarCursos() {

        const input = document.getElementById("buscarCurso");

        const texto = input.value.toLowerCase().trim();

        const resultados = document.getElementById("resultadosCursos");

        const cursos = document.querySelectorAll(".curso-item");


        // ---------------------------------------------------------
        // SI EL BUSCADOR ESTÁ VACÍO
        // ---------------------------------------------------------

        if (texto === "") {

            resultados.classList.add("hidden");

            cursos.forEach(curso => {
                curso.style.display = "flex";
            });

            ocultarSinResultadosCursos();

            return;
        }


        resultados.classList.remove("hidden");

        let encontrados = 0;


        cursos.forEach(curso => {

            const nombre =
                (curso.dataset.nombre || "").toLowerCase();

            const docente =
                (curso.dataset.docente || "").toLowerCase();


            const coincide =
                nombre.includes(texto) ||
                docente.includes(texto);


            if (coincide) {

                curso.style.display = "flex";

                encontrados++;

            }
            else {

                curso.style.display = "none";

            }

        });


        if (encontrados === 0) {

            mostrarSinResultadosCursos();

        }
        else {

            ocultarSinResultadosCursos();

        }

    }


    function mostrarSinResultadosCursos() {

        const mensaje =
            document.getElementById("sinResultadosCursos");

        if (mensaje) {
            mensaje.classList.remove("hidden");
        }

    }


    function ocultarSinResultadosCursos() {

        const mensaje =
            document.getElementById("sinResultadosCursos");

        if (mensaje) {
            mensaje.classList.add("hidden");
        }

    }


    function seleccionarCurso(elemento) {

        cursoSeleccionadoId =
            elemento.dataset.id;

        const nombre =
            elemento.dataset.nombre;

        const docente =
            elemento.dataset.docente;


        document
            .getElementById("cursoDocenteId")
            .value = cursoSeleccionadoId;


        document
            .getElementById("buscarCurso")
            .value = "";


        document
            .getElementById("resultadosCursos")
            .classList
            .add("hidden");


        document
            .getElementById("cursoSeleccionadoNombre")
            .textContent = nombre;


        document
            .getElementById("cursoSeleccionadoDocente")
            .textContent = "Docente: " + docente;


        document
            .getElementById("cursoSeleccionado")
            .classList
            .remove("hidden");


        ocultarError();

    }


    function limpiarCurso() {

        cursoSeleccionadoId = "";


        document
            .getElementById("cursoDocenteId")
            .value = "";


        document
            .getElementById("buscarCurso")
            .value = "";


        document
            .getElementById("cursoSeleccionado")
            .classList
            .add("hidden");


        document
            .getElementById("resultadosCursos")
            .classList
            .add("hidden");


        // RESTAURAR TODOS LOS CURSOS

        document
            .querySelectorAll(".curso-item")
            .forEach(curso => {

                curso.style.display = "flex";

            });


        ocultarSinResultadosCursos();

    }


    // =========================================================
    // ESTUDIANTES
    // =========================================================

    function filtrarEstudiantes() {

        const input =
            document.getElementById("buscarEstudiante");

        const texto =
            input.value.toLowerCase().trim();

        const resultados =
            document.getElementById("resultadosEstudiantes");

        const estudiantes =
            document.querySelectorAll(".estudiante-item");


        // ---------------------------------------------------------
        // SI EL BUSCADOR ESTÁ VACÍO
        // ---------------------------------------------------------

        if (texto === "") {

            resultados.classList.add("hidden");

            estudiantes.forEach(estudiante => {
                estudiante.style.display = "flex";
            });

            ocultarSinResultadosEstudiantes();

            return;
        }


        resultados.classList.remove("hidden");

        let encontrados = 0;


        estudiantes.forEach(estudiante => {

            const nombre =
                (estudiante.dataset.nombre || "").toLowerCase();

            const codigo =
                (estudiante.dataset.codigo || "").toLowerCase();


            const coincide =
                nombre.includes(texto) ||
                codigo.includes(texto);


            if (coincide) {

                estudiante.style.display = "flex";

                encontrados++;

            }
            else {

                estudiante.style.display = "none";

            }

        });


        if (encontrados === 0) {

            mostrarSinResultadosEstudiantes();

        }
        else {

            ocultarSinResultadosEstudiantes();

        }

    }


    function mostrarSinResultadosEstudiantes() {

        const mensaje =
            document.getElementById("sinResultadosEstudiantes");

        if (mensaje) {
            mensaje.classList.remove("hidden");
        }

    }


    function ocultarSinResultadosEstudiantes() {

        const mensaje =
            document.getElementById("sinResultadosEstudiantes");

        if (mensaje) {
            mensaje.classList.add("hidden");
        }

    }


    function seleccionarEstudiante(elemento) {

        estudianteSeleccionadoId =
            elemento.dataset.id;

        const nombre =
            elemento.dataset.nombre;

        const codigo =
            elemento.dataset.codigo;


        document
            .getElementById("alumnoId")
            .value = estudianteSeleccionadoId;


        document
            .getElementById("buscarEstudiante")
            .value = "";


        document
            .getElementById("resultadosEstudiantes")
            .classList
            .add("hidden");


        document
            .getElementById("estudianteSeleccionadoNombre")
            .textContent = nombre;


        document
            .getElementById("estudianteSeleccionadoCodigo")
            .textContent = "Código: " + codigo;


        document
            .getElementById("estudianteSeleccionado")
            .classList
            .remove("hidden");


        ocultarError();

    }


    function limpiarEstudiante() {

        estudianteSeleccionadoId = "";


        document
            .getElementById("alumnoId")
            .value = "";


        document
            .getElementById("buscarEstudiante")
            .value = "";


        document
            .getElementById("estudianteSeleccionado")
            .classList
            .add("hidden");


        document
            .getElementById("resultadosEstudiantes")
            .classList
            .add("hidden");


        // RESTAURAR TODOS LOS ESTUDIANTES

        document
            .querySelectorAll(".estudiante-item")
            .forEach(estudiante => {

                estudiante.style.display = "flex";

            });


        ocultarSinResultadosEstudiantes();

    }


    // =========================================================
    // CONTINUAR
    // =========================================================

    function continuarMatricula() {

        const cursoDocenteId =
            document
                .getElementById("cursoDocenteId")
                .value;


        const alumnoId =
            document
                .getElementById("alumnoId")
                .value;


        // ---------------------------------------------------------
        // VALIDACIÓN
        // ---------------------------------------------------------

        if (!cursoDocenteId) {

            mostrarError(
                "Debes seleccionar un curso."
            );

            return;
        }


        if (!alumnoId) {

            mostrarError(
                "Debes seleccionar un estudiante."
            );

            return;
        }


        // ---------------------------------------------------------
        // OBTENER INFORMACIÓN DEL CURSO
        // ---------------------------------------------------------

        const curso =
            document.querySelector(
                `.curso-item[data-id="${cursoDocenteId}"]`
            );


        // ---------------------------------------------------------
        // OBTENER INFORMACIÓN DEL ESTUDIANTE
        // ---------------------------------------------------------

        const estudiante =
            document.querySelector(
                `.estudiante-item[data-id="${alumnoId}"]`
            );


        if (!curso || !estudiante) {

            mostrarError(
                "No se pudo obtener la información seleccionada."
            );

            return;
        }


        // ---------------------------------------------------------
        // DATOS DEL CURSO
        // ---------------------------------------------------------

        const cursoNombre =
            curso.dataset.nombre;

        const cursoDocente =
            curso.dataset.docente;


        // ---------------------------------------------------------
        // DATOS DEL ESTUDIANTE
        // ---------------------------------------------------------

        const estudianteNombre =
            estudiante.dataset.nombre;

        const estudianteCodigo =
            estudiante.dataset.codigo;


        // ---------------------------------------------------------
        // ACTUALIZAR RESUMEN
        // ---------------------------------------------------------

        document
            .getElementById("resumenCursoNombre")
            .textContent = cursoNombre;


        document
            .getElementById("resumenCursoDocente")
            .textContent =
            "Docente: " + cursoDocente;


        document
            .getElementById("resumenEstudianteNombre")
            .textContent =
            estudianteNombre;


        document
            .getElementById("resumenEstudianteCodigo")
            .textContent =
            "Código: " + estudianteCodigo;


        // ---------------------------------------------------------
        // CAMBIAR ESTADO DE LA PÁGINA
        // ---------------------------------------------------------

        document
            .getElementById("resumenVacio")
            .classList
            .add("hidden");


        document
            .getElementById("resumenMatricula")
            .classList
            .remove("hidden");


        document
            .getElementById("estadoResumen")
            .classList
            .remove("hidden");


        // ---------------------------------------------------------
        // CERRAR MODAL
        // ---------------------------------------------------------

        cerrarModalMatricula();


        // ---------------------------------------------------------
        // SCROLL HACIA EL RESUMEN
        // ---------------------------------------------------------

        document
            .getElementById("resumenMatricula")
            .scrollIntoView({
                behavior: "smooth",
                block: "center"
            });


        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    }


    // =========================================================
    // RESTAURAR SELECCIÓN
    // =========================================================

    function restaurarSeleccion() {

        const cursoDocenteId =
            document
                .getElementById("cursoDocenteId")
                .value;


        const alumnoId =
            document
                .getElementById("alumnoId")
                .value;


        // ---------------------------------------------------------
        // CURSO
        // ---------------------------------------------------------

        if (cursoDocenteId) {

            const curso =
                document.querySelector(
                    `.curso-item[data-id="${cursoDocenteId}"]`
                );


            if (curso) {

                document
                    .getElementById("cursoSeleccionadoNombre")
                    .textContent =
                    curso.dataset.nombre;


                document
                    .getElementById("cursoSeleccionadoDocente")
                    .textContent =
                    "Docente: " + curso.dataset.docente;


                document
                    .getElementById("cursoSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }


        // ---------------------------------------------------------
        // ESTUDIANTE
        // ---------------------------------------------------------

        if (alumnoId) {

            const estudiante =
                document.querySelector(
                    `.estudiante-item[data-id="${alumnoId}"]`
                );


            if (estudiante) {

                document
                    .getElementById("estudianteSeleccionadoNombre")
                    .textContent =
                    estudiante.dataset.nombre;


                document
                    .getElementById("estudianteSeleccionadoCodigo")
                    .textContent =
                    "Código: " +
                    estudiante.dataset.codigo;


                document
                    .getElementById("estudianteSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }

    }


    // =========================================================
    // CANCELAR MATRÍCULA
    // =========================================================

    function cancelarMatricula() {

        cursoSeleccionadoId = "";

        estudianteSeleccionadoId = "";


        document
            .getElementById("cursoDocenteId")
            .value = "";


        document
            .getElementById("alumnoId")
            .value = "";


        document
            .getElementById("resumenMatricula")
            .classList
            .add("hidden");


        document
            .getElementById("resumenVacio")
            .classList
            .remove("hidden");


        document
            .getElementById("estadoResumen")
            .classList
            .add("hidden");


        limpiarCurso();

        limpiarEstudiante();

    }


    // =========================================================
    // ERRORES
    // =========================================================

    function mostrarError(mensaje) {

        document
            .getElementById("mensajeErrorModal")
            .textContent = mensaje;


        document
            .getElementById("errorModal")
            .classList
            .remove("hidden");

    }


    function ocultarError() {

        document
            .getElementById("errorModal")
            .classList
            .add("hidden");

    }


    // =========================================================
    // ESCAPE
    // =========================================================

    document.addEventListener("keydown", function(event) {

        if (event.key === "Escape") {

            const modal =
                document.getElementById("modalMatricula");


            if (!modal.classList.contains("hidden")) {

                cerrarModalMatricula();

            }

        }

    });


    // =========================================================
    // LUCIDE
    // =========================================================

    document.addEventListener("DOMContentLoaded", function() {

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    });

</script>