    // =========================================================
    // PARENTESCO
    // =========================================================

    function toggleOtroDetalle() {

        const parentesco =
            document
                .getElementById("parentescoSelect")
                .value;

        const container =
            document
                .getElementById("otroDetalleContainer");

        const detalle =
            document
                .getElementById("parentescoDetalleInput");


        if (parentesco === "Otro") {

            container.classList.remove("hidden");

            detalle.required = true;

        }
        else {

            container.classList.add("hidden");

            detalle.required = false;

            detalle.value = "";

        }

    }


    // =========================================================
    // CONTINUAR
    // =========================================================

    function continuarAsignacion() {

        const apoderadoId =
            document
                .getElementById("apoderadoId")
                .value;


        const estudianteId =
            document
                .getElementById("estudianteId")
                .value;


        const parentesco =
            document
                .getElementById("parentescoSelect")
                .value;


        const detalle =
            document
                .getElementById("parentescoDetalleInput")
                .value.trim();


        // VALIDAR APODERADO

        if (!apoderadoId) {

            mostrarError(
                "Debes seleccionar un apoderado."
            );

            return;
        }


        // VALIDAR ESTUDIANTE

        if (!estudianteId) {

            mostrarError(
                "Debes seleccionar un estudiante."
            );

            return;
        }


        // VALIDAR PARENTESCO

        if (!parentesco) {

            mostrarError(
                "Debes seleccionar el parentesco familiar."
            );

            return;
        }


        // VALIDAR OTRO

        if (parentesco === "Otro" && detalle === "") {

            mostrarError(
                "Debes especificar el parentesco familiar."
            );

            return;
        }


        // OBTENER ELEMENTOS

        const apoderado =
            document.querySelector(
                `.apoderado-item[data-id="${apoderadoId}"]`
            );


        const estudiante =
            document.querySelector(
                `.estudiante-item[data-id="${estudianteId}"]`
            );


        if (!apoderado || !estudiante) {

            mostrarError(
                "No se pudo obtener la información seleccionada."
            );

            return;
        }


        // ACTUALIZAR HIDDEN

        document
            .getElementById("parentesco")
            .value = parentesco;


        document
            .getElementById("parentescoDetalle")
            .value =
            parentesco === "Otro"
                ? detalle
                : "";


        // ACTUALIZAR RESUMEN

        document
            .getElementById("resumenApoderadoNombre")
            .textContent =
            apoderado.dataset.nombre;


        document
            .getElementById("resumenEstudianteNombre")
            .textContent =
            estudiante.dataset.nombre;


        document
            .getElementById("resumenParentesco")
            .textContent =
            parentesco === "Otro"
                ? "Otro: " + detalle
                : parentesco;


        // CAMBIAR ESTADO

        document
            .getElementById("resumenVacio")
            .classList
            .add("hidden");


        document
            .getElementById("resumenAsignacion")
            .classList
            .remove("hidden");


        document
            .getElementById("estadoResumen")
            .classList
            .remove("hidden");


        // CERRAR MODAL

        cerrarModalAsignacion();


        // SCROLL

        document
            .getElementById("resumenAsignacion")
            .scrollIntoView({
                behavior: "smooth",
                block: "center"
            });


        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    }


    // =========================================================
    // RESTAURAR SELECCIÓN
    // =========================================================

    function restaurarSeleccion() {

        const apoderadoId =
            document
                .getElementById("apoderadoId")
                .value;


        const estudianteId =
            document
                .getElementById("estudianteId")
                .value;


        const parentesco =
            document
                .getElementById("parentesco")
                .value;


        const detalle =
            document
                .getElementById("parentescoDetalle")
                .value;


        // APODERADO

        if (apoderadoId) {

            const apoderado =
                document.querySelector(
                    `.apoderado-item[data-id="${apoderadoId}"]`
                );


            if (apoderado) {

                document
                    .getElementById("apoderadoSeleccionadoNombre")
                    .textContent =
                    apoderado.dataset.nombre;


                document
                    .getElementById("apoderadoSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }


        // ESTUDIANTE

        if (estudianteId) {

            const estudiante =
                document.querySelector(
                    `.estudiante-item[data-id="${estudianteId}"]`
                );


            if (estudiante) {

                document
                    .getElementById("estudianteSeleccionadoNombre")
                    .textContent =
                    estudiante.dataset.nombre;


                document
                    .getElementById("estudianteSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }


        // PARENTESCO

        if (parentesco) {

            document
                .getElementById("parentescoSelect")
                .value =
                parentesco;


            toggleOtroDetalle();


            if (parentesco === "Otro") {

                document
                    .getElementById("parentescoDetalleInput")
                    .value =
                    detalle;

            }

        }

    }


    // =========================================================
    // CANCELAR
    // =========================================================

    function cancelarAsignacion() {

        apoderadoSeleccionadoId = "";

        estudianteSeleccionadoId = "";


        document
            .getElementById("apoderadoId")
            .value = "";


        document
            .getElementById("estudianteId")
            .value = "";


        document
            .getElementById("parentesco")
            .value = "";


        document
            .getElementById("parentescoDetalle")
            .value = "";


        document
            .getElementById("parentescoSelect")
            .value = "";


        document
            .getElementById("parentescoDetalleInput")
            .value = "";


        document
            .getElementById("otroDetalleContainer")
            .classList
            .add("hidden");


        document
            .getElementById("resumenAsignacion")
            .classList
            .add("hidden");


        document
            .getElementById("resumenVacio")
            .classList
            .remove("hidden");


        document
            .getElementById("estadoResumen")
            .classList
            .add("hidden");


        limpiarApoderado();

        limpiarEstudiante();

    }


    // =========================================================
    // ERROR
    // =========================================================

    function mostrarError(mensaje) {

        document
            .getElementById("mensajeErrorModal")
            .textContent =
            mensaje;


        document
            .getElementById("errorModal")
            .classList
            .remove("hidden");

    }


    function ocultarError() {

        document
            .getElementById("errorModal")
            .classList
            .add("hidden");

    }


    // =========================================================
    // ESCAPE
    // =========================================================

    document.addEventListener("keydown", function(event) {

        if (event.key === "Escape") {

            const modal =
                document.getElementById("modalAsignacion");


            if (!modal.classList.contains("hidden")) {

                cerrarModalAsignacion();

            }

        }

    });


    // =========================================================
    // LUCIDE
    // =========================================================

    document.addEventListener("DOMContentLoaded", function() {

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    });

</script>