@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ApoderadoAsignacionGrupoVM>

@{
    ViewData["Title"] = "Listado de asignaciones apoderados - estudiantes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var totalApoderados = Model?.Count ?? 0;
    var totalAsignaciones = Model?.Sum(g => g.CantidadHijos) ?? 0;
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-violet-100">Asignación académica</p>
                <h2 class="mt-2 text-3xl font-extrabold">Listado de asignaciones de apoderados</h2>
                <p class="mt-3 max-w-2xl text-violet-100">
                    Apoderados agrupados con sus estudiantes asignados y vinculados.
                </p>
            </div>
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="list" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="x-circle" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Apoderados con hijos</p>
                    <h3 class="mt-2 text-3xl font-extrabold">@totalApoderados</h3>
                </div>
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i data-lucide="users" class="h-6 w-6"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex items-start justify-between">
                <p class="text-sm text-slate-500">Distribución de parentescos</p>
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                    <i data-lucide="pie-chart" class="h-6 w-6"></i>
                </div>
            </div>
            @{
                var totalPadres = Model?.SelectMany(g => g.Hijos).Count(h => h.Parentesco == "Padre") ?? 0;
                var totalMadres = Model?.SelectMany(g => g.Hijos).Count(h => h.Parentesco == "Madre") ?? 0;
                var totalTutores = Model?.SelectMany(g => g.Hijos).Count(h => h.Parentesco == "Tutor") ?? 0;
                var totalOtros = Model?.SelectMany(g => g.Hijos).Count(h => h.Parentesco == "Otro") ?? 0;
                var totalGeneral = totalPadres + totalMadres + totalTutores + totalOtros;
            }
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-center">
                    <p class="text-2xl font-extrabold text-emerald-700">@totalPadres</p>
                    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Padres</p>
                </div>
                <div class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-center">
                    <p class="text-2xl font-extrabold text-rose-700">@totalMadres</p>
                    <p class="text-xs font-semibold uppercase tracking-wide text-rose-600">Madres</p>
                </div>
                <div class="rounded-xl border border-blue-200 bg-blue-50 p-3 text-center">
                    <p class="text-2xl font-extrabold text-blue-700">@totalTutores</p>
                    <p class="text-xs font-semibold uppercase tracking-wide text-blue-600">Tutores</p>
                </div>
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-center">
                    <p class="text-2xl font-extrabold text-amber-700">@totalOtros</p>
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-600">Otros</p>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Total asignaciones</p>
                    <h3 class="mt-2 text-3xl font-extrabold">@totalAsignaciones</h3>
                </div>
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                    <i data-lucide="clipboard-list" class="h-6 w-6"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <a asp-action="AsignarApoderadoEstudiante" asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Regresar
        </a>
        <a asp-action="AsignarApoderadoEstudiante" asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="user-plus" class="h-4 w-4"></i>
            Nueva asignación
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay asignaciones registradas</h3>
                    <p class="mt-1 text-sm">Cuando asignes apoderados a estudiantes, aparecerán aquí agrupados.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var grupo in Model)
            {
                <div class="rounded-3xl border border-slate-200 bg-white overflow-hidden">
                    <div class="flex flex-col gap-2 border-b border-slate-200 bg-slate-50 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-950">@grupo.NombreApoderado</h3>
                            <p class="text-sm text-slate-500">@grupo.EmailApoderado</p>
                        </div>
                        <span class="inline-flex items-center gap-2 rounded-full bg-violet-100 px-4 py-1.5 text-sm font-semibold text-violet-700">
                            <i data-lucide="users" class="h-4 w-4"></i>
                            @grupo.CantidadHijos hijo(s)
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full table-fixed text-left text-sm">
                            <thead class="bg-white text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="w-[30%] px-6 py-3 font-semibold">Estudiante</th>
                                    <th class="w-[20%] px-6 py-3 font-semibold">Código</th>
                                    <th class="w-[20%] px-6 py-3 font-semibold">Parentesco</th>
                                    <th class="w-[15%] px-6 py-3 font-semibold">Fecha</th>
                                    <th class="w-[15%] px-6 py-3 font-semibold text-right">Acción</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var hijo in grupo.Hijos)
                                {
                                    var parentescoClass = hijo.Parentesco switch
                                    {
                                        "Padre" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                        "Madre" => "bg-rose-50 text-rose-700 border-rose-200",
                                        "Tutor" => "bg-blue-50 text-blue-700 border-blue-200",
                                        "Otro" => "bg-amber-50 text-amber-700 border-amber-200",
                                        _ => "bg-slate-50 text-slate-700 border-slate-200"
                                    };
                                    <tr>
                                        <td class="w-[30%] px-6 py-4 font-medium text-slate-900 truncate">@hijo.NombreEstudiante</td>
                                        <td class="w-[20%] px-6 py-4 text-slate-600">@hijo.CodigoEstudiante</td>
                                        <td class="w-[20%] px-6 py-4">
                                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold @parentescoClass">
                                                @hijo.Parentesco
                                                @if (!string.IsNullOrEmpty(hijo.ParentescoDetalle))
                                                {
                                                    <span class="ml-1 font-normal opacity-75">(@hijo.ParentescoDetalle)</span>
                                                }
                                            </span>
                                        </td>
                                        <td class="w-[15%] px-6 py-4 text-slate-500">@hijo.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                        <td class="w-[15%] px-6 py-4 text-right">
                                            <button type="button"
                                                    onclick="abrirModalDesasignar(@hijo.Id, '@Html.Raw((hijo.NombreEstudiante ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', '@Html.Raw((grupo.NombreApoderado ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', '@hijo.Parentesco')"
                                                    class="inline-flex items-center gap-1 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-100">
                                                <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                                                Desasignar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</section>

<div id="modalDesasignar"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
    <div class="w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-2xl">
        <div class="bg-gradient-to-r from-red-600 to-rose-600 px-6 py-5 text-white">
            <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15">
                    <i data-lucide="shield-alert" class="h-7 w-7"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-red-100">Acción sensible</p>
                    <h3 class="mt-1 text-xl font-extrabold leading-tight">Confirmar desasignación</h3>
                </div>
            </div>
        </div>

        <div class="space-y-4 px-6 pt-5 pb-3">
            <p class="text-sm leading-6 text-slate-600">
                ¿Seguro que deseas desasignar a este estudiante del apoderado seleccionado?
            </p>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="space-y-3">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                            <i data-lucide="user" class="h-4 w-4"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estudiante</p>
                            <p id="modalEstudiante" class="mt-0.5 text-sm font-bold text-slate-950"></p>
                        </div>
                    </div>

                    <div class="border-t border-slate-200"></div>

                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                            <i data-lucide="users" class="h-4 w-4"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Apoderado</p>
                            <p id="modalApoderado" class="mt-0.5 text-sm font-bold text-slate-950"></p>
                        </div>
                    </div>

                    <div class="border-t border-slate-200"></div>

                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                            <i data-lucide="heart" class="h-4 w-4"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Parentesco</p>
                            <p id="modalParentesco" class="mt-0.5 text-sm font-bold text-slate-950"></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <p class="text-xs leading-5 font-medium">
                    Esta acción no se puede deshacer. El estudiante quedará sin apoderado asignado.
                </p>
            </div>
        </div>

        <form asp-action="DesasignarApoderadoEstudianteViewModel"
              asp-controller="Secretaria"
              method="post"
              class="flex flex-col gap-3 px-6 pb-5 pt-3 sm:flex-row sm:justify-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="modalAsignacionId" value="" />

            <button type="button"
                    onclick="cerrarModalDesasignar()"
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                <i data-lucide="x" class="h-4 w-4"></i>
                Cancelar
            </button>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                <i data-lucide="trash-2" class="h-4 w-4"></i>
                Confirmar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Secretaria/ListAsignarApoderadoEstudiante.js" asp-append-version="true"></script>
}