@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.AsignacionCursoDocenteViewModel

@{
    ViewData["Title"] = "Asignación curso - docente";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">

        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

            <div>
                <p class="text-sm font-medium text-blue-100">
                    Asignación académica
                </p>

                <h2 class="mt-2 text-3xl font-extrabold">
                    Asignar curso - docente
                </h2>

                <p class="mt-3 max-w-2xl text-blue-100">
                    Asigna un curso a un docente dentro del período académico correspondiente.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="user-plus" class="h-8 w-8"></i>
            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MENSAJE DE ÉXITO -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">

            <div class="flex items-start gap-3">

                <i data-lucide="check-circle-2"
                   class="mt-0.5 h-5 w-5">
                </i>

                <p class="text-sm font-semibold">
                    @TempData["Success"]
                </p>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- MENSAJE DE ERROR -->
    <!-- ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">

            <div class="flex items-start gap-3">

                <i data-lucide="x-circle"
                   class="mt-0.5 h-5 w-5">
                </i>

                <p class="text-sm font-semibold">
                    @TempData["Error"]
                </p>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ACCIONES -->
    <!-- ========================================================= -->

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">

        <a asp-action="ListAsignarCursoDocente"
           asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">

            <i data-lucide="list" class="h-4 w-4"></i>

            Listado de asignaciones

        </a>

        <!--
        <button type="button"
                onclick="abrirModalAsignacion()"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

            <i data-lucide="plus" class="h-4 w-4"></i>

            Nueva asignación

        </button>
        -->

    </div>


    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="grid gap-6 lg:grid-cols-3">

        <!-- ===================================================== -->
        <!-- RESUMEN -->
        <!-- ===================================================== -->

        <div class="flex min-h-[650px] flex-col rounded-3xl border border-slate-200 bg-white shadow-sm lg:col-span-2">

            <!-- CABECERA -->
            <div class="border-b border-slate-200 px-6 py-5">

                <div class="flex items-center justify-between gap-4">

                    <div>

                        <h3 class="text-lg font-bold text-slate-950">
                            Resumen de la asignación
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Revisa los datos seleccionados antes de confirmar.
                        </p>

                    </div>

                    <div id="estadoResumen"
                         class="hidden rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">

                        Lista para confirmar

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ESTADO VACÍO -->
            <!-- ================================================= -->

            <div id="resumenVacio"
                 class="flex min-h-[350px] flex-col items-center justify-center px-6 py-12 text-center">

                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">

                    <i data-lucide="clipboard-plus"
                       class="h-8 w-8">
                    </i>

                </div>

                <h4 class="mt-5 text-lg font-bold text-slate-900">
                    Nueva asignación
                </h4>

                <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
                    Selecciona un curso, un docente y el período académico
                    para comenzar con la asignación.
                </p>

                <button type="button"
                        onclick="abrirModalAsignacion()"
                        class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                    <i data-lucide="plus"
                       class="h-4 w-4">
                    </i>

                    Seleccionar datos

                </button>

            </div>


            <!-- ================================================= -->
            <!-- RESUMEN SELECCIONADO -->
            <!-- ================================================= -->

            <div id="resumenAsignacion"
                 class="hidden flex flex-1 flex-col p-6">

                <div class="grid gap-4 md:grid-cols-1">

                    <!-- CURSO -->
                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">

                        <div class="flex items-start gap-4">

                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-600">

                                <i data-lucide="book-open"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <div class="min-w-0">

                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                    Curso
                                </p>

                                <p id="resumenCursoNombre"
                                   class="mt-1 truncate text-base font-bold text-slate-900">
                                </p>

                                <p id="resumenCursoCodigo"
                                   class="mt-1 text-sm text-slate-500">
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- DOCENTE -->
                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">

                        <div class="flex items-start gap-4">

                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600">

                                <i data-lucide="user-round"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <div class="min-w-0">

                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                    Docente
                                </p>

                                <p id="resumenDocenteNombre"
                                   class="mt-1 truncate text-base font-bold text-slate-900">
                                </p>

                                <p id="resumenDocenteEspecialidad"
                                   class="mt-1 text-sm text-slate-500">
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- PERÍODO -->
                    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 ">

                        <div class="flex items-start gap-4">

                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">

                                <i data-lucide="calendar-days"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <div>

                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                    Período académico
                                </p>

                                <p id="resumenPeriodoNombre"
                                   class="mt-1 text-base font-bold text-slate-900">
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- AVISO -->
                <div class="mt-5 flex items-start gap-3 rounded-2xl border border-blue-200 bg-blue-50 p-4 text-blue-800">

                    <i data-lucide="info"
                       class="mt-0.5 h-5 w-5 shrink-0">
                    </i>

                    <p class="text-sm leading-6">
                        Verifica que el curso, docente y período académico sean
                        correctos antes de confirmar la asignación.
                    </p>

                </div>


                <!-- ================================================= -->
                <!-- FORMULARIO FINAL -->
                <!-- ================================================= -->

                <form asp-action="AsignarCursoDocente"
                      asp-controller="Secretaria"
                      method="post"
                      id="formConfirmarAsignacion"
                      class="mt-auto pt-6">

                    @Html.AntiForgeryToken()

                    <!-- VALORES QUE SE ENVIARÁN AL CONTROLLER -->
                    <input type="hidden"
                           id="cursoId"
                           name="cursoId" />

                    <input type="hidden"
                           id="docenteId"
                           name="docenteId" />

                    <input type="hidden"
                           id="periodoId"
                           name="periodoId" />


                    <div class="flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:justify-end">

                        <button type="button"
                                onclick="abrirModalAsignacion()"
                                class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">

                            <i data-lucide="pencil"
                               class="h-4 w-4">
                            </i>

                            Cambiar selección

                        </button>


                        <button type="button"
                                onclick="cancelarAsignacion()"
                                class="inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 bg-white px-5 py-3 text-sm font-semibold text-red-600 transition hover:bg-red-50">

                            <i data-lucide="x"
                               class="h-4 w-4">
                            </i>

                            Cancelar

                        </button>


                        <button type="submit"
                                class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                            <i data-lucide="check"
                               class="h-4 w-4">
                            </i>

                            Confirmar asignación

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- INFORMACIÓN -->
        <!-- ===================================================== -->

        <div class="space-y-6">

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                    <i data-lucide="info"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Información
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Esta acción vincula un curso con un docente para el
                    período académico seleccionado.
                </p>

            </div>


            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">

                    <i data-lucide="shield-check"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Recomendación
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Verifica que el período activo sea correcto antes de
                    guardar la asignación.
                </p>

            </div>


            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">

                    <i data-lucide="check-check"
                       class="h-6 w-6">
                    </i>

                </div>

                <h3 class="mt-5 font-bold text-slate-950">
                    Confirmación
                </h3>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Los datos no se guardarán hasta que confirmes la
                    asignación desde el resumen.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ============================================================= -->
<!-- MODAL -->
<!-- ============================================================= -->

<div id="modalAsignacion"
     class="fixed inset-0 z-50 hidden">

    <!-- FONDO -->
    <div class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm"
         onclick="cerrarModalAsignacion()">
    </div>


    <!-- CONTENEDOR -->
    <div class="relative flex min-h-full items-center justify-center p-4">

        <div class="w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="flex items-start justify-between border-b border-slate-200 px-6 py-5">

                <div>

                    <div class="flex items-center gap-3">

                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                            <i data-lucide="user-plus"
                               class="h-5 w-5">
                            </i>

                        </div>

                        <div>

                            <h3 class="text-lg font-bold text-slate-950">
                                Seleccionar asignación
                            </h3>

                            <p class="mt-1 text-sm text-slate-500">
                                Busca y selecciona los datos de la asignación.
                            </p>

                        </div>

                    </div>

                </div>


                <button type="button"
                        onclick="cerrarModalAsignacion()"
                        class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">

                    <i data-lucide="x"
                       class="h-5 w-5">
                    </i>

                </button>

            </div>


            <!-- ================================================= -->
            <!-- CONTENIDO -->
            <!-- ================================================= -->

            <div class="max-h-[75vh] overflow-y-auto p-6">

                <div class="space-y-5">


                    <!-- ========================================= -->
                    <!-- CURSO -->
                    <!-- ========================================= -->

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Curso
                        </label>

                        <div class="relative">

                            <i data-lucide="book-open"
                               class="absolute left-4 top-3.5 h-5 w-5 text-slate-400">
                            </i>

                            <input type="text"
                                   id="buscarCurso"
                                   placeholder="Buscar por nombre o código..."
                                   autocomplete="off"
                                   oninput="filtrarCursos()"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        </div>


                        <!-- SELECCIONADO -->
                        <div id="cursoSeleccionado"
                             class="mt-3 hidden rounded-xl border border-blue-200 bg-blue-50 p-3">

                            <div class="flex items-center justify-between">

                                <div class="flex items-center gap-3">

                                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 text-blue-600">

                                        <i data-lucide="book-open"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div>

                                        <p id="cursoSeleccionadoNombre"
                                           class="text-sm font-bold text-slate-800">
                                        </p>

                                        <p id="cursoSeleccionadoCodigo"
                                           class="text-xs text-slate-500">
                                        </p>

                                    </div>

                                </div>


                                <button type="button"
                                        onclick="limpiarCurso()"
                                        class="text-slate-400 transition hover:text-red-500">

                                    <i data-lucide="x"
                                       class="h-4 w-4">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <!-- RESULTADOS -->
                        <div id="resultadosCursos"
                             class="mt-2 hidden max-h-48 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg">

                            <!-- MENSAJE SIN RESULTADOS -->
                            <div id="sinResultadosCursos"
                                 class="hidden px-4 py-6 text-center text-sm text-slate-500">

                                <div class="flex flex-col items-center justify-center">

                                    <i data-lucide="search-x"
                                       class="mb-2 h-6 w-6 text-slate-400">
                                    </i>

                                    <p class="font-medium">
                                        No se encontraron cursos
                                    </p>

                                    <p class="mt-1 text-xs text-slate-400">
                                        Intenta buscar por otro nombre o código.
                                    </p>

                                </div>

                            </div>


                            @foreach (var curso in Model.Cursos)
                            {
                                <button type="button"
                                        class="curso-item flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition last:border-0 hover:bg-blue-50"
                                        data-id="@curso.id"
                                        data-nombre="@curso.nombreCurso"
                                        data-codigo="@curso.codigoCurso"
                                        onclick="seleccionarCurso(this)">

                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                        <i data-lucide="book-open"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div class="min-w-0">

                                        <p class="truncate text-sm font-semibold text-slate-800">
                                            @curso.nombreCurso
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Código: @curso.codigoCurso
                                        </p>

                                    </div>

                                </button>
                            }

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- DOCENTE -->
                    <!-- ========================================= -->

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Docente
                        </label>

                        <div class="relative">

                            <i data-lucide="school"
                               class="absolute left-4 top-3.5 h-5 w-5 text-slate-400">
                            </i>

                            <input type="text"
                                   id="buscarDocente"
                                   placeholder="Buscar por nombre o especialidad..."
                                   autocomplete="off"
                                   oninput="filtrarDocentes()"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />

                        </div>


                        <!-- SELECCIONADO -->
                        <div id="docenteSeleccionado"
                             class="mt-3 hidden rounded-xl border border-indigo-200 bg-indigo-50 p-3">

                            <div class="flex items-center justify-between">

                                <div class="flex items-center gap-3">

                                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">

                                        <i data-lucide="user-round"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div>

                                        <p id="docenteSeleccionadoNombre"
                                           class="text-sm font-bold text-slate-800">
                                        </p>

                                        <p id="docenteSeleccionadoEspecialidad"
                                           class="text-xs text-slate-500">
                                        </p>

                                    </div>

                                </div>


                                <button type="button"
                                        onclick="limpiarDocente()"
                                        class="text-slate-400 transition hover:text-red-500">

                                    <i data-lucide="x"
                                       class="h-4 w-4">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <!-- RESULTADOS -->
                        <div id="resultadosDocentes"
                             class="mt-2 hidden max-h-48 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg">

                            <!-- MENSAJE SIN RESULTADOS -->
                            <div id="sinResultadosDocentes"
                                 class="hidden px-4 py-6 text-center text-sm text-slate-500">

                                <div class="flex flex-col items-center justify-center">

                                    <i data-lucide="search-x"
                                       class="mb-2 h-6 w-6 text-slate-400">
                                    </i>

                                    <p class="font-medium">
                                        No se encontraron docentes
                                    </p>

                                    <p class="mt-1 text-xs text-slate-400">
                                        Intenta buscar por otro nombre o especialidad.
                                    </p>

                                </div>

                            </div>


                            @foreach (var docente in Model.Docentes)
                            {
                                <button type="button"
                                        class="docente-item flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition last:border-0 hover:bg-indigo-50"
                                        data-id="@docente.id"
                                        data-nombre="@docente.nombreCompleto"
                                        data-especialidad="@docente.especialidad"
                                        onclick="seleccionarDocente(this)">

                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                        <i data-lucide="user-round"
                                           class="h-4 w-4">
                                        </i>

                                    </div>

                                    <div class="min-w-0">

                                        <p class="truncate text-sm font-semibold text-slate-800">
                                            @docente.nombreCompleto
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            @docente.especialidad
                                        </p>

                                    </div>

                                </button>
                            }

                        </div>
                    </div>


                    <!-- ========================================= -->
                    <!-- PERÍODO -->
                    <!-- ========================================= -->

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Período académico
                        </label>

                        <div class="relative">

                            <i data-lucide="calendar-days"
                               class="absolute left-4 top-3.5 h-5 w-5 text-slate-400">
                            </i>

                            <select id="modalPeriodoId"
                                    class="w-full appearance-none rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100">

                                <option value="">
                                    Seleccionar un período académico
                                </option>

                                @foreach (var periodo in Model.Periodos)
                                {
                                    <option value="@periodo.id"
                                            selected="@(periodo.esActivo ? "selected" : null)">

                                        @periodo.nombrePeriodo @(periodo.esActivo ? "(Activo)" : "")

                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <!-- ERROR -->
                    <div id="errorModal"
                         class="hidden rounded-xl border border-red-200 bg-red-50 p-4">

                        <div class="flex items-start gap-3">

                            <i data-lucide="alert-circle"
                               class="mt-0.5 h-5 w-5 shrink-0 text-red-500">
                            </i>

                            <p id="mensajeErrorModal"
                               class="text-sm font-medium text-red-700">
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <div class="flex flex-col gap-3 border-t border-slate-200 px-6 py-5 sm:flex-row sm:justify-end">

                <button type="button"
                        onclick="cerrarModalAsignacion()"
                        class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">

                    <i data-lucide="x"
                       class="h-4 w-4">
                    </i>

                    Cancelar

                </button>


                <button type="button"
                        onclick="continuarAsignacion()"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                    Continuar

                    <i data-lucide="arrow-right"
                       class="h-4 w-4">
                    </i>

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    // =========================================================
    // VARIABLES
    // =========================================================

    let cursoSeleccionadoId = "";
    let docenteSeleccionadoId = "";
    let periodoSeleccionadoId = "";


    // =========================================================
    // MODAL
    // =========================================================

    function abrirModalAsignacion() {

        document
            .getElementById("modalAsignacion")
            .classList
            .remove("hidden");

        document.body.classList.add("overflow-hidden");

        // Si ya existen datos seleccionados,
        // mostramos nuevamente esos valores.
        restaurarSeleccion();

    }


    function cerrarModalAsignacion() {

        document
            .getElementById("modalAsignacion")
            .classList
            .add("hidden");

        document.body.classList.remove("overflow-hidden");

        ocultarError();

    }


    // =========================================================
    // CURSOS
    // =========================================================

    function filtrarCursos() {

        const input = document.getElementById("buscarCurso");

        const texto = input.value.toLowerCase().trim();

        const resultados = document.getElementById("resultadosCursos");

        const cursos = document.querySelectorAll(".curso-item");

        // Mostrar todos nuevamente cuando el buscador está vacío
        if (texto === "") {

            resultados.classList.add("hidden");

            cursos.forEach(curso => {
                curso.style.display = "flex";
            });

            ocultarSinResultadosCursos();

            return;
        }

        resultados.classList.remove("hidden");

        let encontrados = 0;

        cursos.forEach(curso => {

            const nombre = curso.dataset.nombre.toLowerCase();

            const codigo = curso.dataset.codigo.toLowerCase();

            const coincide =
                nombre.includes(texto) ||
                codigo.includes(texto);

            if (coincide) {

                curso.style.display = "flex";

                encontrados++;

            } else {

                curso.style.display = "none";

            }

        });


        // Mostrar u ocultar mensaje
        if (encontrados === 0) {

            mostrarSinResultadosCursos();

        } else {

            ocultarSinResultadosCursos();

        }

    }

    function mostrarSinResultadosCursos() {

        const mensaje = document.getElementById("sinResultadosCursos");

        if (mensaje) {

            mensaje.classList.remove("hidden");

        }

    }


    function ocultarSinResultadosCursos() {

        const mensaje = document.getElementById("sinResultadosCursos");

        if (mensaje) {

            mensaje.classList.add("hidden");

        }

    }

    function seleccionarCurso(elemento) {

        cursoSeleccionadoId = elemento.dataset.id;

        const nombre = elemento.dataset.nombre;
        const codigo = elemento.dataset.codigo;

        document
            .getElementById("cursoId")
            .value = cursoSeleccionadoId;

        document
            .getElementById("buscarCurso")
            .value = "";

        document
            .getElementById("resultadosCursos")
            .classList
            .add("hidden");

        document
            .getElementById("cursoSeleccionadoNombre")
            .textContent = nombre;

        document
            .getElementById("cursoSeleccionadoCodigo")
            .textContent = "Código: " + codigo;

        document
            .getElementById("cursoSeleccionado")
            .classList
            .remove("hidden");

        ocultarError();

    }


    function limpiarCurso() {

        cursoSeleccionadoId = "";

        document
            .getElementById("cursoId")
            .value = "";

        document
            .getElementById("buscarCurso")
            .value = "";

        document
            .getElementById("cursoSeleccionado")
            .classList
            .add("hidden");

        document
            .getElementById("resultadosCursos")
            .classList
            .add("hidden");


        // Restaurar todos los cursos
        document
            .querySelectorAll(".curso-item")
            .forEach(curso => {

                curso.style.display = "flex";

            });


        ocultarSinResultadosCursos();

    }


    // =========================================================
    // DOCENTES
    // =========================================================

    function filtrarDocentes() {

        const input = document.getElementById("buscarDocente");

        const texto = input.value.toLowerCase().trim();

        const resultados = document.getElementById("resultadosDocentes");

        const docentes = document.querySelectorAll(".docente-item");


        // Mostrar todos nuevamente cuando el buscador está vacío
        if (texto === "") {

            resultados.classList.add("hidden");

            docentes.forEach(docente => {
                docente.style.display = "flex";
            });

            ocultarSinResultadosDocentes();

            return;
        }


        resultados.classList.remove("hidden");

        let encontrados = 0;


        docentes.forEach(docente => {

            const nombre =
                docente.dataset.nombre.toLowerCase();

            const especialidad =
                docente.dataset.especialidad.toLowerCase();

            const coincide =
                nombre.includes(texto) ||
                especialidad.includes(texto);


            if (coincide) {

                docente.style.display = "flex";

                encontrados++;

            } else {

                docente.style.display = "none";

            }

        });


        // Mostrar u ocultar mensaje
        if (encontrados === 0) {

            mostrarSinResultadosDocentes();

        } else {

            ocultarSinResultadosDocentes();

        }

    }

    function mostrarSinResultadosDocentes() {

        const mensaje =
            document.getElementById("sinResultadosDocentes");

        if (mensaje) {

            mensaje.classList.remove("hidden");

        }

    }


    function ocultarSinResultadosDocentes() {

        const mensaje =
            document.getElementById("sinResultadosDocentes");

        if (mensaje) {

            mensaje.classList.add("hidden");

        }

    }


    function seleccionarDocente(elemento) {

        docenteSeleccionadoId = elemento.dataset.id;

        const nombre = elemento.dataset.nombre;
        const especialidad = elemento.dataset.especialidad;

        document
            .getElementById("docenteId")
            .value = docenteSeleccionadoId;

        document
            .getElementById("buscarDocente")
            .value = "";

        document
            .getElementById("resultadosDocentes")
            .classList
            .add("hidden");

        document
            .getElementById("docenteSeleccionadoNombre")
            .textContent = nombre;

        document
            .getElementById("docenteSeleccionadoEspecialidad")
            .textContent = especialidad;

        document
            .getElementById("docenteSeleccionado")
            .classList
            .remove("hidden");

        ocultarError();

    }


    function limpiarDocente() {

        docenteSeleccionadoId = "";

        document
            .getElementById("docenteId")
            .value = "";

        document
            .getElementById("buscarDocente")
            .value = "";

        document
            .getElementById("docenteSeleccionado")
            .classList
            .add("hidden");

        document
            .getElementById("resultadosDocentes")
            .classList
            .add("hidden");


        // Restaurar todos los docentes
        document
            .querySelectorAll(".docente-item")
            .forEach(docente => {

                docente.style.display = "flex";

            });


        ocultarSinResultadosDocentes();

    }


    // =========================================================
    // CONTINUAR
    // =========================================================

    function continuarAsignacion() {

        const cursoId = document
            .getElementById("cursoId")
            .value;

        const docenteId = document
            .getElementById("docenteId")
            .value;

        const periodoId = document
            .getElementById("modalPeriodoId")
            .value;


        // -----------------------------------------
        // VALIDACIÓN
        // -----------------------------------------

        if (!cursoId) {

            mostrarError("Debes seleccionar un curso.");

            return;
        }


        if (!docenteId) {

            mostrarError("Debes seleccionar un docente.");

            return;
        }


        if (!periodoId) {

            mostrarError("Debes seleccionar un período académico.");

            return;
        }


        // -----------------------------------------
        // GUARDAMOS PERÍODO
        // -----------------------------------------

        periodoSeleccionadoId = periodoId;

        document
            .getElementById("periodoId")
            .value = periodoId;


        // -----------------------------------------
        // OBTENER INFORMACIÓN
        // -----------------------------------------

        const curso = document.querySelector(
            `.curso-item[data-id="${cursoId}"]`
        );

        const docente = document.querySelector(
            `.docente-item[data-id="${docenteId}"]`
        );


        if (!curso || !docente) {

            mostrarError("No se pudo obtener la información seleccionada.");

            return;
        }


        const cursoNombre = curso.dataset.nombre;
        const cursoCodigo = curso.dataset.codigo;

        const docenteNombre = docente.dataset.nombre;
        const docenteEspecialidad = docente.dataset.especialidad;


        // -----------------------------------------
        // PERÍODO
        // -----------------------------------------

        const periodoSelect = document
            .getElementById("modalPeriodoId");

        const periodoNombre =
            periodoSelect.options[
                periodoSelect.selectedIndex
            ].text;


        // -----------------------------------------
        // ACTUALIZAR RESUMEN
        // -----------------------------------------

        document
            .getElementById("resumenCursoNombre")
            .textContent = cursoNombre;

        document
            .getElementById("resumenCursoCodigo")
            .textContent = "Código: " + cursoCodigo;


        document
            .getElementById("resumenDocenteNombre")
            .textContent = docenteNombre;

        document
            .getElementById("resumenDocenteEspecialidad")
            .textContent = docenteEspecialidad;


        document
            .getElementById("resumenPeriodoNombre")
            .textContent = periodoNombre;


        // -----------------------------------------
        // CAMBIAR ESTADO DE LA PÁGINA
        // -----------------------------------------

        document
            .getElementById("resumenVacio")
            .classList
            .add("hidden");

        document
            .getElementById("resumenAsignacion")
            .classList
            .remove("hidden");

        document
            .getElementById("estadoResumen")
            .classList
            .remove("hidden");


        // -----------------------------------------
        // CERRAR MODAL
        // -----------------------------------------

        cerrarModalAsignacion();

        // -----------------------------------------
        // SCROLL HACIA EL RESUMEN
        // -----------------------------------------

        document
            .getElementById("resumenAsignacion")
            .scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    }


    // =========================================================
    // RESTAURAR SELECCIÓN
    // =========================================================

    function restaurarSeleccion() {

        const cursoId = document
            .getElementById("cursoId")
            .value;

        const docenteId = document
            .getElementById("docenteId")
            .value;

        const periodoId = document
            .getElementById("periodoId")
            .value;


        // CURSO

        if (cursoId) {

            const curso = document.querySelector(
                `.curso-item[data-id="${cursoId}"]`
            );

            if (curso) {

                document
                    .getElementById("cursoSeleccionadoNombre")
                    .textContent = curso.dataset.nombre;

                document
                    .getElementById("cursoSeleccionadoCodigo")
                    .textContent =
                    "Código: " + curso.dataset.codigo;

                document
                    .getElementById("cursoSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }


        // DOCENTE

        if (docenteId) {

            const docente = document.querySelector(
                `.docente-item[data-id="${docenteId}"]`
            );

            if (docente) {

                document
                    .getElementById("docenteSeleccionadoNombre")
                    .textContent = docente.dataset.nombre;

                document
                    .getElementById("docenteSeleccionadoEspecialidad")
                    .textContent =
                    docente.dataset.especialidad;

                document
                    .getElementById("docenteSeleccionado")
                    .classList
                    .remove("hidden");

            }

        }


        // PERÍODO

        if (periodoId) {

            document
                .getElementById("modalPeriodoId")
                .value = periodoId;

        }

    }


    // =========================================================
    // CANCELAR ASIGNACIÓN
    // =========================================================

    function cancelarAsignacion() {

        cursoSeleccionadoId = "";
        docenteSeleccionadoId = "";
        periodoSeleccionadoId = "";

        document
            .getElementById("cursoId")
            .value = "";

        document
            .getElementById("docenteId")
            .value = "";

        document
            .getElementById("periodoId")
            .value = "";


        document
            .getElementById("resumenAsignacion")
            .classList
            .add("hidden");

        document
            .getElementById("resumenVacio")
            .classList
            .remove("hidden");

        document
            .getElementById("estadoResumen")
            .classList
            .add("hidden");

        limpiarCurso();
        limpiarDocente();

        document
            .getElementById("modalPeriodoId")
            .value = "";

    }


    // =========================================================
    // ERRORES
    // =========================================================

    function mostrarError(mensaje) {

        document
            .getElementById("mensajeErrorModal")
            .textContent = mensaje;

        document
            .getElementById("errorModal")
            .classList
            .remove("hidden");

    }


    function ocultarError() {

        document
            .getElementById("errorModal")
            .classList
            .add("hidden");

    }


    // =========================================================
    // ESCAPE
    // =========================================================

    document.addEventListener("keydown", function(event) {

        if (event.key === "Escape") {

            const modal =
                document.getElementById("modalAsignacion");

            if (!modal.classList.contains("hidden")) {

                cerrarModalAsignacion();

            }

        }

    });


    // =========================================================
    // LUCIDE
    // =========================================================

    document.addEventListener("DOMContentLoaded", function() {

        if (typeof lucide !== "undefined") {

            lucide.createIcons();

        }

    });

</script>