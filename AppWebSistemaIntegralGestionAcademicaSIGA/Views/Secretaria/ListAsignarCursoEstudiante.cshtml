@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.AsignacionCursoEstudianteVM>

@{
    ViewData["Title"] = "Listado de matrículas cursos - estudiantes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var total = Model?.Count ?? 0;
    var conRegistros = Model?.Count(x => x.TieneRegistros) ?? 0;
    var sinRegistros = total - conRegistros;
    var activas = Model?.Count(x => string.Equals(x.Estado, "Activo", StringComparison.OrdinalIgnoreCase)) ?? 0;
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-emerald-100">Asignación académica</p>
                <h2 class="mt-2 text-3xl font-extrabold">Listado de asignaciones de estudiantes</h2>
                <p class="mt-3 max-w-2xl text-emerald-100">
                    Consulta, revisa y gestiona las matrículas curso – estudiante registradas en el sistema.
                </p>
            </div>
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="graduation-cap" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Asignaciones activas</p>
            <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@activas</h3>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Asignaciones sin registros</p>
            <h3 class="mt-2 text-3xl font-extrabold text-blue-600">@sinRegistros</h3>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Asignaciones con notas/asistencias</p>
            <h3 class="mt-2 text-3xl font-extrabold text-amber-600">@conRegistros</h3>
        </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <a asp-action="AsignarCursoEstudiante" asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Regresar
        </a>
        <a asp-action="AsignarCursoEstudiante" asp-controller="Secretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="user-plus" class="h-4 w-4"></i>
            Nueva matrícula
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay matrículas registradas</h3>
                    <p class="mt-1 text-sm">Cuando matricules estudiantes en cursos, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Matrículas registradas</h3>
                    <p class="mt-1 text-sm text-slate-500">
                        Relación estudiante – curso – docente – periodo.
                    </p>
                </div>
                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700">
                    <i data-lucide="users" class="h-4 w-4"></i>
                    @total matrículas
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[1100px] text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Estudiante</th>
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Docente</th>
                            <th class="px-6 py-4 font-bold">Periodo</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                            <th class="px-6 py-4 font-bold">Registros</th>
                            <th class="px-6 py-4 text-right font-bold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var a in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                                            <i data-lucide="user-round" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@a.NombreEstudiante</p>
                                            <p class="mt-1 text-xs text-slate-500">Código: @a.CodigoEstudiante</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="book-open" class="h-4 w-4 text-slate-400"></i>
                                        <div>
                                            <p class="font-semibold text-slate-900">@a.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@a.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-5 text-slate-600">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="school" class="h-4 w-4 text-slate-400"></i>
                                        @a.NombreDocente
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                                        <i data-lucide="calendar-days" class="h-3.5 w-3.5"></i>
                                        @a.NombrePeriodo
                                    </span>
                                </td>
                                <td class="px-6 py-5">
                                    @if (string.Equals(a.Estado, "Activo", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            @a.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
                                            <i data-lucide="circle" class="h-3.5 w-3.5"></i>
                                            @a.Estado
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex flex-wrap gap-2">
                                        <span class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-700">
                                            <i data-lucide="clipboard-list" class="h-3.5 w-3.5"></i>
                                            Notas: @a.CantidadNotas
                                        </span>
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                                            <i data-lucide="calendar-check" class="h-3.5 w-3.5"></i>
                                            Asist.: @a.CantidadAsistencias
                                        </span>
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex justify-end">
                                        @if (a.TieneRegistros)
                                        {
                                            <button type="button"
                                                    disabled
                                                    class="inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-slate-300 px-4 py-2 text-sm font-semibold text-white"
                                                    title="Tiene notas o asistencias registradas">
                                                <i data-lucide="lock" class="h-4 w-4"></i>
                                                Desasignar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700"
                                                    onclick="abrirModalDesasignar(@a.Id, '@Html.Raw((a.NombreEstudiante ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))', '@Html.Raw((a.NombreCurso ?? "").Replace("\\", "\\\\").Replace("'", "\\'"))')">
                                                <i data-lucide="trash-2" class="h-4 w-4"></i>
                                                Desasignar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<div id="modalDesasignar"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
    <div class="w-full max-w-md overflow-hidden rounded-3xl bg-white">
        <div class="bg-gradient-to-r from-red-600 to-rose-600 px-6 py-5 text-white">
            <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15">
                    <i data-lucide="shield-alert" class="h-7 w-7"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-red-100">Acción sensible</p>
                    <h3 class="mt-1 text-xl font-extrabold leading-tight">Confirmar desasignación</h3>
                </div>
            </div>
        </div>

        <div class="space-y-5 px-6 py-6">
            <p class="text-sm leading-6 text-slate-600">
                ¿Seguro que deseas desmatricular a este estudiante del curso seleccionado?
            </p>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="space-y-3">
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                            <i data-lucide="user-round" class="h-4 w-4"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estudiante</p>
                            <p id="modalEstudiante" class="mt-0.5 text-sm font-bold text-slate-950"></p>
                        </div>
                    </div>

                    <div class="border-t border-slate-200"></div>

                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                            <i data-lucide="book-open" class="h-4 w-4"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Curso</p>
                            <p id="modalCurso" class="mt-0.5 text-sm font-bold text-slate-950"></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5 shrink-0"></i>
                <p class="text-xs leading-5 font-medium">
                    Esta acción no se puede deshacer. Solo se permite si no existen notas ni asistencias asociadas.
                </p>
            </div>
        </div>

        <form asp-action="DesasignarCursoEstudianteViewModel"
              asp-controller="Secretaria"
              method="post"
              class="flex flex-col gap-3 px-6 pb-5 sm:flex-row sm:justify-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="modalMatriculaId" value="" />

            <button type="button"
                    onclick="cerrarModalDesasignar()"
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                <i data-lucide="x" class="h-4 w-4"></i>
                Cancelar
            </button>
            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                <i data-lucide="trash-2" class="h-4 w-4"></i>
                Confirmar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Secretaria/ListAsignarCursoEstudiante.js" asp-append-version="true"></script>
}