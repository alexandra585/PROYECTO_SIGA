@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.SecretariaDashboardViewModel

@{
    ViewData["Title"] = "Panel principal de Secretaría";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-violet-100">Panel de control de asignaciones</p>
                <h2 class="mt-2 text-3xl font-extrabold">Bienvenido al módulo de secretaría</h2>
                <p class="mt-3 text-violet-100">
                    Período activo: <span class="font-semibold text-white">@Model.PeriodoActivo</span>
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="clipboard-list" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Curso - Docente</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.TotalAsignacionesCursoDocente</h3>
                    <p class="mt-1 text-sm text-slate-500">Docentes asignados a cursos</p>
                </div>
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <i data-lucide="user-plus" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Curso - Estudiante</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.TotalMatriculas</h3>
                    <p class="mt-1 text-sm text-slate-500">Estudiantes matriculados</p>
                </div>
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                    <i data-lucide="user-check" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Apoderado - Estudiante</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.TotalAsignacionesApoderadoEstudiante</h3>
                    <p class="mt-1 text-sm text-slate-500">Relaciones de parentesco registradas</p>
                </div>
                <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
                    <i data-lucide="users" class="h-7 w-7"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-5">
            <h3 class="text-lg font-bold text-slate-950">Acciones rápidas</h3>
            <p class="mt-1 text-sm text-slate-500">
                Gestiona las asignaciones académicas de forma rápida.
            </p>
        </div>

        <div class="grid gap-5 p-6 md:grid-cols-3">
            <a asp-action="AsignarCursoDocente" asp-controller="Secretaria"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:border-indigo-200 hover:bg-indigo-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-600 text-white">
                    <i data-lucide="user-plus" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-5 font-bold text-slate-950 group-hover:text-indigo-700">Asignar Curso - Docente</h4>
                <p class="mt-2 text-sm text-slate-600">Asigna docentes a los cursos del periodo activo.</p>
            </a>

            <a asp-action="AsignarCursoEstudiante" asp-controller="Secretaria"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:border-emerald-200 hover:bg-emerald-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-600 text-white">
                    <i data-lucide="user-check" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-5 font-bold text-slate-950 group-hover:text-emerald-700">Asignar Curso - Estudiante</h4>
                <p class="mt-2 text-sm text-slate-600">Matricula estudiantes en los cursos disponibles.</p>
            </a>

            <a asp-action="AsignarApoderadoEstudiante" asp-controller="Secretaria"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-6 transition hover:border-rose-200 hover:bg-rose-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-rose-600 text-white">
                    <i data-lucide="users" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-5 font-bold text-slate-950 group-hover:text-rose-700">Asignar Apoderado - Estudiante</h4>
                <p class="mt-2 text-sm text-slate-600">Vincula apoderados con sus estudiantes.</p>
            </a>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <a asp-action="ListAsignarCursoDocente" asp-controller="Secretaria"
           class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-indigo-200 hover:shadow-md">
            <div class="flex items-center gap-3">
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <i data-lucide="list" class="h-5 w-5"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-950">Listado Curso - Docente</h4>
                    <p class="text-sm text-slate-500">Gestión de las asignaciones de los docentes.</p>
                </div>
            </div>
        </a>

        <a asp-action="ListAsignarCursoEstudiante" asp-controller="Secretaria"
           class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
            <div class="flex items-center gap-3">
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                    <i data-lucide="list" class="h-5 w-5"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-950">Listado Curso - Estudiante</h4>
                    <p class="text-sm text-slate-500">Gestión de matrículas de los estudiantes.</p>
                </div>
            </div>
        </a>

        <a asp-action="ListAsignarApoderadoEstudiante" asp-controller="Secretaria"
           class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-rose-200 hover:shadow-md">
            <div class="flex items-center gap-3">
                <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
                    <i data-lucide="list" class="h-5 w-5"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-950">Listado Apoderado - Estudiante</h4>
                    <p class="text-sm text-slate-500">Gestión de los apoderados acádemicos.</p>
                </div>
            </div>
        </a>
    </div>
</section>