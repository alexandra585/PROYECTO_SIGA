@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.UsuarioListadoViewModel

@{
    ViewData["Title"] = "Lista de usuarios";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Administración del sistema</p>
                <h2 class="mt-2 text-3xl font-extrabold">Gestión de usuarios</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Administra usuarios registrados, roles, estado de cuenta y acciones de seguridad.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="users" class="h-8 w-8"></i>
            </div>
        </div>
    </div>


    <!-- ========================= -->
    <!-- MENSAJE SUCCESS -->
    <!-- ========================= -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }


    <!-- ========================= -->
    <!-- MENSAJE ERROR -->
    <!-- ========================= -->
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }


    <!-- ========================= -->
    <!-- FILTROS -->
    <!-- ========================= -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

        <div class="mb-5">
            <h3 class="text-lg font-bold text-slate-950">
                Buscar usuarios
            </h3>

            <p class="mt-1 text-sm text-slate-500">
                Utiliza los filtros para encontrar usuarios específicos.
            </p>
        </div>

        <form asp-action="ListUsuario"
              asp-controller="CRUDUsuario"
              method="get"
              class="grid gap-4 md:grid-cols-2 lg:grid-cols-5">

            <!-- Nombre -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Nombre
                </label>

                <input type="text"
                       name="nombre"
                       value="@Model.Nombre"
                       placeholder="Nombre completo"
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
            </div>

            <!-- Email -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Correo
                </label>

                <input type="text"
                       name="email"
                       value="@Model.Email"
                       placeholder="Correo electrónico"
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
            </div>

            <!-- Rol -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Rol
                </label>

                <select name="rol"
                        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                    <option value="">Todos los roles</option>

                    @if (Model.Rol == "Director")
                    {
                        <option value="Director" selected>Director</option>
                    }
                    else
                    {
                        <option value="Director">Director</option>
                    }

                    @if (Model.Rol == "Secretaria")
                    {
                        <option value="Secretaria" selected>Secretaria</option>
                    }
                    else
                    {
                        <option value="Secretaria">Secretaria</option>
                    }

                    @if (Model.Rol == "Docente")
                    {
                        <option value="Docente" selected>Docente</option>
                    }
                    else
                    {
                        <option value="Docente">Docente</option>
                    }

                    @if (Model.Rol == "Estudiante")
                    {
                        <option value="Estudiante" selected>Estudiante</option>
                    }
                    else
                    {
                        <option value="Estudiante">Estudiante</option>
                    }

                    @if (Model.Rol == "Apoderado")
                    {
                        <option value="Apoderado" selected>Apoderado</option>
                    }
                    else
                    {
                        <option value="Apoderado">Apoderado</option>
                    }

                </select>
            </div>

            <!-- Estado -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Estado
                </label>

                <select name="activo"
                        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                    @if (Model.Activo == null)
                    {
                        <option value="" selected>Todos</option>
                    }
                    else
                    {
                        <option value="">Todos</option>
                    }

                    @if (Model.Activo == true)
                    {
                        <option value="true" selected>Activos</option>
                    }
                    else
                    {
                        <option value="true">Activos</option>
                    }

                    @if (Model.Activo == false)
                    {
                        <option value="false" selected>Inactivos</option>
                    }
                    else
                    {
                        <option value="false">Inactivos</option>
                    }

                </select>
            </div>

            <!-- Botones -->
            <div class="flex items-end gap-2">

                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                    <i data-lucide="search" class="h-4 w-4"></i>
                    Buscar
                </button>

                <a asp-action="ListUsuario"
                   asp-controller="CRUDUsuario"
                   class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100"
                   title="Limpiar filtros">

                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
                </a>

            </div>

        </form>
    </div>


    <!-- ========================= -->
    <!-- INFORMACIÓN DEL LISTADO -->
    <!-- ========================= -->
    @if (Model.Paginacion.TotalRegistros == 0)
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">

            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>

                <div>
                    <h3 class="font-bold">
                        No se encontraron usuarios
                    </h3>

                    <p class="mt-1 text-sm">
                        No existen usuarios que coincidan con los filtros seleccionados.
                    </p>
                </div>
            </div>

        </div>
    }
    else
    {
        <!-- ========================= -->
        <!-- RESUMEN -->
        <!-- ========================= -->
        <div class="grid gap-6 md:grid-cols-5">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Directores</p>
                <h3 class="mt-2 text-3xl font-extrabold text-rose-600">@Model.Usuarios.Count(u => u.rol == "Director")</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Secretarias</p>
                <h3 class="mt-2 text-3xl font-extrabold text-purple-600">@Model.Usuarios.Count(u => u.rol == "Secretaria")</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Docentes</p>
                <h3 class="mt-2 text-3xl font-extrabold text-blue-600">@Model.Usuarios.Count(u => u.rol == "Docente")</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Estudiantes</p>
                <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Usuarios.Count(u => u.rol == "Estudiante")</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Apoderados</p>
                <h3 class="mt-2 text-3xl font-extrabold text-amber-600">@Model.Usuarios.Count(u => u.rol == "Apoderado")</h3>
            </div>
        </div>


        <!-- ========================= -->
        <!-- NUEVO USUARIO -->
        <!-- ========================= -->
        <div class="flex justify-end">

            <a asp-action="CreateUsuario"
               asp-controller="CRUDUsuario"
               class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">

                <i data-lucide="plus" class="h-4 w-4"></i>

                Nuevo usuario
            </a>

        </div>


        <!-- ========================= -->
        <!-- TABLA -->
        <!-- ========================= -->
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">

            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <div>
                    <h3 class="text-lg font-bold text-slate-950">
                        Usuarios registrados
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        Página @Model.Paginacion.Pagina de @Model.Paginacion.TotalPaginas
                    </p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">

                    <i data-lucide="users" class="h-4 w-4"></i>

                    @Model.Paginacion.TotalRegistros usuarios

                </span>

            </div>


            <div class="overflow-x-auto">

                <table class="w-full min-w-[1000px] text-left text-sm">

                    <thead>

                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">

                            <th class="px-6 py-4 font-bold">
                                Usuario
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Correo
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Rol
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Detalle
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Estado
                            </th>

                            <th class="px-6 py-4 text-right font-bold">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-100">

                        @foreach (var usuario in Model.Usuarios)
                        {
                            <tr class="transition hover:bg-slate-50">

                                <!-- Usuario -->
                                <td class="px-6 py-5">

                                    <div class="flex items-center gap-3">

                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                                            <i data-lucide="user-round" class="h-5 w-5"></i>

                                        </div>

                                        <div>

                                            <p class="font-bold text-slate-950">
                                                @usuario.nombreCompleto
                                            </p>

                                            <p class="mt-1 text-xs text-slate-500">
                                                ID: @usuario.id
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- Correo -->
                                <td class="px-6 py-5 text-slate-600">

                                    <div class="flex items-center gap-2">

                                        <i data-lucide="mail" class="h-4 w-4 text-slate-400"></i>

                                        @usuario.email

                                    </div>

                                </td>


                                <!-- Rol -->
                                <td class="px-6 py-5">

                                    @if (usuario.rol == "Director")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-3 py-1 text-xs font-bold text-rose-700">

                                            <i data-lucide="crown" class="h-3.5 w-3.5"></i>

                                            Director

                                        </span>
                                    }
                                    else if (usuario.rol == "Secretaria")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-purple-50 px-3 py-1 text-xs font-bold text-purple-700">

                                            <i data-lucide="calendar" class="h-3.5 w-3.5"></i>

                                            Secretaria

                                        </span>
                                    }
                                    else if (usuario.rol == "Docente")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">

                                            <i data-lucide="school" class="h-3.5 w-3.5"></i>

                                            Docente

                                        </span>
                                    }
                                    else if (usuario.rol == "Estudiante")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">

                                            <i data-lucide="graduation-cap" class="h-3.5 w-3.5"></i>

                                            Estudiante

                                        </span>
                                    }
                                    else if (usuario.rol == "Apoderado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">

                                            <i data-lucide="heart" class="h-3.5 w-3.5"></i>

                                            Apoderado

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-3 py-1 text-xs font-bold text-gray-700">

                                            <i data-lucide="help-circle" class="h-3.5 w-3.5"></i>

                                            Sin rol

                                        </span>
                                    }

                                </td>


                                <!-- Detalle -->
                                <td class="px-6 py-5 text-slate-600">

                                    @if (usuario.rol == "Director")
                                    {
                                        <span>
                                            Alta dirección
                                        </span>
                                    }
                                    else if (usuario.rol == "Secretaria")
                                    {
                                        <span>
                                            Recepcionista académico
                                        </span>
                                    }
                                    else if (usuario.rol == "Docente")
                                    {
                                        <span>
                                            Especialidad: @usuario.especialidad
                                        </span>
                                    }
                                    else if (usuario.rol == "Estudiante")
                                    {
                                        <span>
                                            Código de estudiante: @usuario.codigoEstudiante
                                        </span>
                                    }
                                    else if (usuario.rol == "Apoderado")
                                    {
                                        <span>
                                            Representante académico
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Sin rol
                                        </span>
                                    }

                                </td>


                                <!-- Estado -->
                                <td class="px-6 py-5">

                                    @if (usuario.activo)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">

                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">

                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <!-- Acciones -->
                                <td class="px-6 py-5">

                                    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">

                                        <a asp-action="EditUsuario"
                                           asp-controller="CRUDUsuario"
                                           asp-route-id="@usuario.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">

                                            <i data-lucide="edit-3" class="h-4 w-4"></i>

                                            Editar

                                        </a>


                                        @if (usuario.rol != "Director")
                                        {
                                            <a asp-action="DeleteUsuario"
                                               asp-controller="CRUDUsuario"
                                               asp-route-id="@usuario.id"
                                               class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">

                                                <i data-lucide="trash-2" class="h-4 w-4"></i>

                                                Eliminar

                                            </a>
                                        }


                                        <a asp-action="ResetPassword"
                                           asp-controller="CRUDUsuario"
                                           asp-route-id="@usuario.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">

                                            <i data-lucide="key-round" class="h-4 w-4"></i>

                                            Resetear

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ========================= -->
            <!-- PAGINACIÓN -->
            <!-- ========================= -->
            <div class="flex flex-col gap-4 border-t border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <!-- Información -->
                <div class="text-sm text-slate-500">

                    @if (Model.Paginacion.TotalRegistros > 0)
                    {
                        var primerRegistro =
                            ((Model.Paginacion.Pagina - 1)
                            * Model.Paginacion.TamanioPagina) + 1;

                        var ultimoRegistro =
                            Math.Min(
                                Model.Paginacion.Pagina
                                * Model.Paginacion.TamanioPagina,
                                Model.Paginacion.TotalRegistros
                            );

                        <span>
                            Mostrando
                            <span class="font-semibold text-slate-700">
                                @primerRegistro
                            </span>
                            -
                            <span class="font-semibold text-slate-700">
                                @ultimoRegistro
                            </span>
                            de
                            <span class="font-semibold text-slate-700">
                                @Model.Paginacion.TotalRegistros
                            </span>
                            registros
                        </span>
                    }
                    else
                    {
                        <span>No hay registros</span>
                    }

                </div>


                <!-- Botones -->
                @if (Model.Paginacion.TotalPaginas > 1)
                {
                    <div class="flex items-center gap-1">

                        <!-- ANTERIOR -->
                        @if (Model.Paginacion.TienePaginaAnterior)
                        {
                            <a asp-action="ListUsuario"
                               asp-controller="CRUDUsuario"
                               asp-route-pagina="@(Model.Paginacion.Pagina - 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-rol="@Model.Rol"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </span>
                        }


                        <!-- PRIMERA PÁGINA -->
                        @if (Model.Paginacion.Pagina == 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                1
                            </span>
                        }
                        else
                        {
                            <a asp-action="ListUsuario"
                               asp-controller="CRUDUsuario"
                               asp-route-pagina="1"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-rol="@Model.Rol"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">
                                1
                            </a>
                        }


                        @{
                            int paginaActual = Model.Paginacion.Pagina;
                            int totalPaginas = Model.Paginacion.TotalPaginas;

                            // Mostrar páginas cercanas a la actual
                            int inicio = Math.Max(2, paginaActual - 1);
                            int fin = Math.Min(totalPaginas - 1, paginaActual + 1);
                        }


                        <!-- ... IZQUIERDO -->
                        @if (inicio > 2)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- PÁGINAS INTERMEDIAS -->
                        @for (int pagina = inicio; pagina <= fin; pagina++)
                        {
                            if (pagina == paginaActual)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @pagina
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListUsuario"
                                   asp-controller="CRUDUsuario"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-rol="@Model.Rol"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @pagina

                                </a>
                            }
                        }


                        <!-- ... DERECHO -->
                        @if (fin < totalPaginas - 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- ÚLTIMA PÁGINA -->
                        @if (totalPaginas > 1)
                        {
                            if (paginaActual == totalPaginas)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @totalPaginas
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListUsuario"
                                   asp-controller="CRUDUsuario"
                                   asp-route-pagina="@totalPaginas"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-rol="@Model.Rol"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @totalPaginas

                                </a>
                            }
                        }


                        <!-- SIGUIENTE -->
                        @if (Model.Paginacion.TienePaginaSiguiente)
                        {
                            <a asp-action="ListUsuario"
                               asp-controller="CRUDUsuario"
                               asp-route-pagina="@(Model.Paginacion.Pagina + 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-rol="@Model.Rol"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </span>
                        }

                    </div>
                }

            </div>
        </div>
    }

</section>
