@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Eliminar usuario";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-red-600 to-rose-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-red-100">Administración de usuarios</p>
                <h2 class="mt-2 text-3xl font-extrabold">Eliminar usuario</h2>
                <p class="mt-3 max-w-2xl text-red-100">
                    Confirma el retiro del usuario seleccionado del sistema académico.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="trash-2" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-amber-800">
        <div class="flex items-start gap-3">
            <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
            <div>
                <h3 class="font-bold">Advertencia importante</h3>
                <p class="mt-1 text-sm">
                    ¿Está seguro que desea eliminar este usuario? Esta acción no se puede deshacer.
                </p>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Datos del usuario</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Revisa la información antes de confirmar la eliminación.
                </p>
            </div>

            <div class="mt-6 grid gap-5 md:grid-cols-2">
                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">ID</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.id</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre completo</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.nombreCompleto</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Correo electrónico</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.email</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Rol</p>

                    @if (Model.rol == "Director")
                    {
                        <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-rose-50 px-3 py-1 text-xs font-bold text-rose-700">
                            <i data-lucide="crown" class="h-3.5 w-3.5"></i>
                            Director
                        </span>
                    }
                    else if (Model.rol == "Docente")
                    {
                        <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                            <i data-lucide="school" class="h-3.5 w-3.5"></i>
                            Docente
                        </span>
                    }
                    else
                    {
                        <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                            <i data-lucide="graduation-cap" class="h-3.5 w-3.5"></i>
                            Estudiante
                        </span>
                    }
                </div>

                <div class="rounded-2xl bg-slate-50 p-4 md:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</p>

                    @if (Model.activo)
                    {
                        <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                            Inactivo
                        </span>
                    }
                </div>
            </div>

            <form asp-action="DeleteConfirmed" asp-controller="CRUDUsuario" method="post" class="mt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id" />
                <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                    <a asp-action="ListUsuario" asp-controller="CRUDUsuario"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                        Confirmar eliminación
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-red-200 bg-red-50 p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-600">
                    <i data-lucide="shield-alert" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-red-900">Acción irreversible</h3>
                <p class="mt-2 text-sm leading-6 text-red-700">
                    Una vez confirmado, el usuario será retirado del sistema según la lógica configurada.
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
                    <i data-lucide="info" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-slate-950">Recomendación</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Verifica que el usuario seleccionado sea correcto antes de continuar.
                </p>
            </div>
        </div>
    </div>
</section>