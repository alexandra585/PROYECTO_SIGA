@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ApoderadoLibretaFiltroViewModel

@{
    ViewData["Title"] = "Filtro de libreta de notas";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-violet-100">Seguimiento académico</p>
                <h2 class="mt-2 text-3xl font-extrabold">Filtro estudiantil de las libretas de notas</h2>
                <p class="mt-3 max-w-2xl text-violet-100">
                    Seleccione su hijo y periodo para ver sus cursos matriculados y calificaciones completas.
                </p>
            </div>
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="clipboard-list" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Filtros</h3>
                <p class="mt-1 text-sm text-slate-500">Selecciona el estudiante y, de forma opcional, su periodo académico.</p>
            </div>

            <form asp-action="ResultFilterLibreta" asp-controller="Apoderado" method="get" class="mt-6 space-y-5">
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Hijo a cargo (obligatorio)</label>
                    <div class="relative">
                        <i data-lucide="user-round" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                        <select name="estudianteId" required
                                class="w-full appearance-none rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100">
                            <option value="">Seleccionar estudiante</option>
                            @if (Model.Hijos != null)
                            {
                                foreach (var hijo in Model.Hijos)
                                {
                                    <option value="@hijo.EstudianteId"
                                            selected="@(Model.EstudianteId == hijo.EstudianteId ? "selected" : null)">
                                        @hijo.NombreCompleto (@hijo.CodigoEstudiante)
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Periodo académico (opcional)</label>
                    <div class="relative">
                        <i data-lucide="calendar-days" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                        <select name="periodoId"
                                class="w-full appearance-none rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100">
                            <option value="">Todos los periodos</option>
                            @if (Model.Periodos != null)
                            {
                                foreach (var p in Model.Periodos)
                                {
                                    <option value="@p.id">
                                        @p.nombrePeriodo @(p.esActivo ? "(Activo)" : "")
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-end">
                    <a asp-action="Dashboard" asp-controller="Apoderado"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        Cancelar
                    </a>
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                        <i data-lucide="search" class="h-4 w-4"></i>
                        Libreta de notas
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                    <i data-lucide="info" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 font-bold text-slate-950">Información</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Al consultar verás los cursos matriculados y las notas separadas por periodo académico.
                </p>
            </div>
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <i data-lucide="sparkles" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 font-bold text-slate-950">Periodo actual</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    El periodo activo se mostrará resaltado respecto a los periodos anteriores.
                </p>
            </div>
        </div>
    </div>
</section>