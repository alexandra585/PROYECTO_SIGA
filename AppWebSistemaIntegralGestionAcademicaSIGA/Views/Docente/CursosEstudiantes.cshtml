@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoEstudianteViewModel>

@{
    ViewData["Title"] = "Estudiantes del curso";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-blue-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium">Gestión docente</p>
                <h2 class="mt-2 text-3xl font-extrabold">Estudiantes del curso</h2>
                <p class="mt-3 max-w-2xl">
                    Consulta los estudiantes matriculados, su carrera, semestre, estado y promedio actual.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="users" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay estudiantes matriculados</h3>
                    <p class="mt-1 text-sm">Cuando existan estudiantes matriculados en este curso, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500">Total estudiantes</p>
                    <h3 class="text-2xl font-extrabold text-blue-600">@Model.Count</h3>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500">Activos</p>
                    <h3 class="text-2xl font-extrabold text-blue-600">@Model.Count(e => e.EstadoMatricula == "Activo")</h3>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500">Inactivos</p>
                    <h3 class="text-2xl font-extrabold text-blue-600">@Model.Count(e => e.EstadoMatricula != "Activo")</h3>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500">Promedio general</p>
                    <h3 class="text-2xl font-extrabold text-blue-600">
                        @(Model.Any(e => e.PromedioActual > 0) ? Model.Where(e => e.PromedioActual > 0).Average(e => e.PromedioActual).ToString("F2") : "0.00")
                    </h3>
                </div>
            </div>
        </div>

        <div class="pb-5">
            <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
                <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-slate-950">Registro nominal de estudiantes</h3>
                        <p class="mt-1 text-sm text-slate-500">Listado completo de estudiantes matriculados en el curso.</p>
                    </div>

                    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                        <i data-lucide="users" class="h-4 w-4"></i>
                        @Model.Count estudiantes
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[1050px] text-left text-sm">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                                <th class="px-6 py-4 font-bold">Estudiante</th>
                                <th class="px-6 py-4 font-bold">Carrera</th>
                                <th class="px-6 py-4 font-bold">Semestre</th>
                                <th class="px-6 py-4 font-bold">Estado</th>
                                <th class="px-6 py-4 font-bold">Promedio</th>
                                <th class="px-6 py-4 text-center font-bold">Acciones</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-100">
                            @foreach (var estudiante in Model)
                            {
                                <tr class="transition hover:bg-slate-50">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                                <i data-lucide="graduation-cap" class="h-5 w-5"></i>
                                            </div>

                                            <div>
                                                <p class="font-bold text-slate-950">@estudiante.NombreCompleto</p>
                                                <p class="mt-1 text-xs text-slate-500">@estudiante.CodigoEstudiante</p>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-5">
                                        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                            @estudiante.NombreCarrera
                                        </span>
                                    </td>

                                    <td class="px-6 py-5 text-slate-600">
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="calendar-days" class="h-4 w-4 text-slate-400"></i>
                                            Semestre @estudiante.SemestreActual
                                        </div>
                                    </td>

                                    <td class="px-6 py-5">
                                        @if (estudiante.EstadoMatricula == "Activo")
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                                <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                                @estudiante.EstadoMatricula
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                                <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                                @estudiante.EstadoMatricula
                                            </span>
                                        }
                                    </td>

                                    <td class="px-6 py-5">
                                        @if (estudiante.PromedioActual > 0)
                                        {
                                            if (estudiante.PromedioActual >= 13)
                                            {
                                                <span class="text-lg font-extrabold text-emerald-600">@estudiante.PromedioActual.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-lg font-extrabold text-red-600">@estudiante.PromedioActual.ToString("F2")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-sm font-semibold text-slate-400">0.00</span>
                                        }
                                    </td>

                                    <td class="px-6 py-5 text-right">
                                        <button type="button"
                                                class="btn-ver-notas inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
                                                data-matricula-id="@estudiante.MatriculaId"
                                                data-nombre="@estudiante.NombreCompleto">
                                            <i data-lucide="chart-no-axes-column" class="h-4 w-4"></i>
                                            Notas
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</section>

<div id="modalNotas" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 px-4 backdrop-blur-sm">
    <div class="w-full max-w-2xl h-[370px] rounded-3xl bg-white p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4 mb-5">
            <div>
                <p class="text-sm font-semibold text-blue-600">Detalle académico</p>
                <h3 class="mt-1 text-2xl font-extrabold text-slate-950" id="modalNotasTitulo">Notas del estudiante</h3>
            </div>

            <button type="button"
                    id="cerrarModalNotas"
                    class="rounded-xl bg-slate-100 p-2 text-slate-500 transition hover:bg-slate-200">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>

        <div id="modalNotasBody" class="mt-5">
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Docente/CursosEstudiantes.js" asp-append-version="true"></script>
    <script>
        window.Urls = window.Urls || {};
        window.Urls.obtenerNotas = '@Url.Action("ObtenerNotasEstudiante", "Docente")';
    </script>
}