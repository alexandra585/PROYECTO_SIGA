@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoDocenteViewModel>

@{
    ViewData["Title"] = "Cursos asignados";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Catálogo docente</p>
                <h2 class="mt-2 text-3xl font-extrabold">Cursos asignados</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Consulta tus cursos designados y accede a estudiantes, asistencias y reportes.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="book-marked" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No tienes cursos asignados</h3>
                    <p class="mt-1 text-sm">Cuando se te asigne un curso, aparecerá en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Total cursos</p>
                <h3 class="mt-2 text-3xl font-extrabold text-slate-950">@Model.Count</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Créditos asignados</p>
                <h3 class="mt-2 text-3xl font-extrabold text-indigo-600">@Model.Sum(c => c.Creditos)</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Periodo actual</p>
                <h3 class="mt-2 text-xl font-extrabold text-blue-600">@Model.First().NombrePeriodo</h3>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Listado de cursos</h3>
                    <p class="mt-1 text-sm text-slate-500">Cursos asignados para la gestión académica.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                    <i data-lucide="layers" class="h-4 w-4"></i>
                    @Model.Count cursos
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Créditos</th>
                            <th class="px-6 py-4 font-bold">Periodo</th>
                            <th class="px-6 py-4 text-right font-bold">Acciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var curso in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                            <i data-lucide="book-open" class="h-5 w-5"></i>
                                        </div>

                                        <div>
                                            <p class="font-bold text-slate-950">@curso.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@curso.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                        @curso.Creditos créditos
                                    </span>
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="calendar-days" class="h-4 w-4 text-slate-400"></i>
                                        @curso.NombrePeriodo
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
                                        <a asp-action="CursosEstudiantes" asp-controller="Docente" asp-route-cursoDocenteId="@curso.CursoDocenteId"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                                            <i data-lucide="users" class="h-4 w-4"></i>
                                            Estudiantes
                                        </a>

                                        <a asp-action="RegistrarAsistencias" asp-controller="Docente" asp-route-cursoDocenteId="@curso.CursoDocenteId"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">
                                            <i data-lucide="calendar-check" class="h-4 w-4"></i>
                                            Asistencias
                                        </a>

                                        <a asp-action="ReporteCurso" asp-controller="Docente" asp-route-cursoDocenteId="@curso.CursoDocenteId"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                                            <i data-lucide="bar-chart-3" class="h-4 w-4"></i>
                                            Reporte
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>