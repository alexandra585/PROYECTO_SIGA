@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.DocenteDashboardViewModel

@{
    ViewData["Title"] = "Panel principal del Docente";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-sky-100">Panel de control académico</p>
                <h2 class="mt-2 text-3xl font-extrabold">Bienvenido al módulo del docente</h2>
                <p class="mt-3 text-sky-100">
                    Especialidad: @Model.especialidad · Grado académico: @Model.gradoAcademico
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="school" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Cursos asignados</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.totalCursosAsignados</h3>
                </div>
                <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                    <i data-lucide="book-marked" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Rol académico</p>
                    <h3 class="mt-2 text-2xl font-extrabold text-emerald-600">Docente</h3>
                </div>
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                    <i data-lucide="badge-check" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Estado</p>
                    <h3 class="mt-2 text-2xl font-extrabold text-indigo-600">Activo</h3>
                </div>
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <i data-lucide="circle-check-big" class="h-7 w-7"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-2 border-b border-slate-200 pb-5">
            <h3 class="text-lg font-bold text-slate-950">Acciones rápidas</h3>
            <p class="text-sm text-slate-500">Accede directamente a las funciones principales del docente.</p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
            <a asp-action="CursosAsignados" asp-controller="Docente"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-blue-200 hover:bg-blue-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-600 text-white">
                    <i data-lucide="book-open" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-4 font-bold text-slate-950">Cursos</h4>
                <p class="mt-2 text-sm text-slate-600">Ver cursos asignados y estudiantes matriculados.</p>
            </a>

            <a asp-action="RegistrarNotas" asp-controller="Docente"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-emerald-200 hover:bg-emerald-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-600 text-white">
                    <i data-lucide="edit-3" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-4 font-bold text-slate-950">Notas</h4>
                <p class="mt-2 text-sm text-slate-600">Registrar o actualizar calificaciones estudiantiles.</p>
            </a>

            <a asp-action="RegistrarAsistencias" asp-controller="Docente"
               class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-amber-200 hover:bg-amber-50">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-500 text-white">
                    <i data-lucide="calendar-check" class="h-6 w-6"></i>
                </div>
                <h4 class="mt-4 font-bold text-slate-950">Asistencias</h4>
                <p class="mt-2 text-sm text-slate-600">Registrar asistencia diaria de estudiantes.</p>
            </a>
        </div>
    </div>
</section>
