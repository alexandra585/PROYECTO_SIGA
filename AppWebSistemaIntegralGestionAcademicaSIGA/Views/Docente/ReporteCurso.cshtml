@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ReporteCursoViewModel

@{
    ViewData["Title"] = "Reporte del curso";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Gestión docente</p>
                <h2 class="mt-2 text-3xl font-extrabold">Reporte del curso</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Consulta el rendimiento académico, promedios y estado de los estudiantes matriculados.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="bar-chart-3" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (ViewBag.Cursos != null)
    {
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-5 text-blue-800">
            <div class="flex items-start gap-3">
                <i data-lucide="info" class="mt-0.5 h-5 w-5"></i>
                <div>
                    <h3 class="font-bold">Selecciona un curso</h3>
                    <p class="mt-1 text-sm">Elige el curso que deseas analizar en el reporte académico.</p>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Curso asignado</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Selecciona un curso para ver sus indicadores de rendimiento.
                </p>
            </div>

            <form asp-action="ReporteCurso" asp-controller="Docente" method="get" class="mt-6">
                <div class="max-w-xl">
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Curso</label>
                    <div class="relative">
                        <i data-lucide="book-open" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>

                        <select name="cursoDocenteId"
                                class="w-full appearance-none rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                                onchange="this.form.submit()">
                            <option value="">Seleccione un curso</option>
                            @foreach (var curso in ViewBag.Cursos as SelectList)
                            {
                                <option value="@curso.Value">@curso.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    }
    else if (Model != null)
    {
        <div class="grid gap-6 lg:grid-cols-3">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
                <div class="flex items-start gap-4">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
                        <i data-lucide="book-open" class="h-7 w-7"></i>
                    </div>

                    <div>
                        <p class="text-sm font-semibold text-blue-600">Curso seleccionado</p>
                        <h3 class="mt-1 text-2xl font-extrabold text-slate-950">@Model.NombreCurso</h3>
                        <p class="mt-2 text-sm text-slate-500">
                            Código: @Model.CodigoCurso · Docente: @Model.NombreDocente · Período: @Model.NombrePeriodo
                        </p>
                    </div>
                </div>

                <div class="mt-6 grid gap-4 md:grid-cols-3">
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Créditos</p>
                        <p class="mt-1 text-2xl font-extrabold text-slate-950">@Model.Creditos</p>
                    </div>

                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estudiantes</p>
                        <p class="mt-1 text-2xl font-extrabold text-slate-950">@Model.TotalEstudiantes</p>
                    </div>

                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Promedio general</p>
                        <p class="mt-1 text-2xl font-extrabold text-blue-600">@Model.PromedioGeneralCurso.ToString("F2")</p>
                    </div>
                </div>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm font-semibold text-slate-500">Rendimiento general</p>

                <div class="mt-4 flex items-end gap-2">
                    <span class="text-5xl font-extrabold text-blue-600">@Model.PromedioGeneralCurso.ToString("F2")</span>
                    <span class="pb-2 text-sm font-semibold text-slate-400">/ 20</span>
                </div>

                <div class="mt-6 h-3 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full bg-blue-500" style="width:@((Model.PromedioGeneralCurso / 20 * 100).ToString("F0"))%"></div>
                </div>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Aprobados</p>
                        <h3 class="mt-2 text-4xl font-extrabold text-emerald-600">@Model.TotalAprobados</h3>
                    </div>
                    <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                        <i data-lucide="check-circle-2" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Desaprobados</p>
                        <h3 class="mt-2 text-4xl font-extrabold text-red-600">@Model.TotalDesaprobados</h3>
                    </div>
                    <div class="rounded-xl bg-red-50 p-3 text-red-600">
                        <i data-lucide="x-circle" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Sin notas</p>
                        <h3 class="mt-2 text-4xl font-extrabold text-amber-600">@Model.TotalSinNotas</h3>
                    </div>
                    <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
                        <i data-lucide="clock" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>
        </div>

        if (!Model.Estudiantes.Any())
        {
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
                <div class="flex items-start gap-4">
                    <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                    <div>
                        <h3 class="font-bold">No hay estudiantes registrados</h3>
                        <p class="mt-1 text-sm">Cuando existan estudiantes matriculados, aparecerán en esta sección.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
                <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-slate-950">Ficha descriptiva del estudiante</h3>
                        <p class="mt-1 text-sm text-slate-500">Detalle de rendimiento individual por estudiante.</p>
                    </div>

                    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                        <i data-lucide="users" class="h-4 w-4"></i>
                        @Model.Estudiantes.Count estudiantes
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[1000px] text-left text-sm">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                                <th class="px-6 py-4 font-bold">Estudiante</th>
                                <th class="px-6 py-4 font-bold">Carrera</th>
                                <th class="px-6 py-4 font-bold">Semestre</th>
                                <th class="px-6 py-4 font-bold">Promedio</th>
                                <th class="px-6 py-4 font-bold">Estado</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-100">
                            @foreach (var est in Model.Estudiantes)
                            {
                                <tr class="transition hover:bg-slate-50">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                                <i data-lucide="graduation-cap" class="h-5 w-5"></i>
                                            </div>

                                            <div>
                                                <p class="font-bold text-slate-950">@est.NombreCompleto</p>
                                                <p class="mt-1 text-xs text-slate-500">@est.CodigoEstudiante</p>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="px-6 py-5">
                                        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                            @est.NombreCarrera
                                        </span>
                                    </td>

                                    <td class="px-6 py-5 text-slate-600">
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="calendar-days" class="h-4 w-4 text-slate-400"></i>
                                            Semestre @est.SemestreActual
                                        </div>
                                    </td>

                                    <td class="px-6 py-5">
                                        @if (est.PromedioActual >= 13)
                                        {
                                            <span class="text-lg font-extrabold text-emerald-600">@est.PromedioActual.ToString("F2")</span>
                                        }
                                        else if (est.PromedioActual > 0)
                                        {
                                            <span class="text-lg font-extrabold text-red-600">@est.PromedioActual.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-semibold text-slate-400">0.00</span>
                                        }
                                    </td>

                                    <td class="px-6 py-5">
                                        @if (est.PromedioActual >= 13)
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                                <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                                Aprobado
                                            </span>
                                        }
                                        else if (est.PromedioActual > 0)
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                                <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                                Desaprobado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                                                <i data-lucide="clock" class="h-3.5 w-3.5"></i>
                                                Sin notas
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</section>