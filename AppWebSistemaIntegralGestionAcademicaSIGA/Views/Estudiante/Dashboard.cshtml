@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.EstudianteDashboardViewModel

@{
    ViewData["Title"] = "Panel principal del Estudiante";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <p class="text-sm text-blue-100">Panel de control académico</p>
        <h2 class="mt-2 text-3xl font-extrabold">Bienvenido al módulo del estudiante</h2>
        <p class="mt-3 text-blue-100">
            Código: @Model.codigoEstudiante · Carrera: @Model.nombreCarrera · Semestre: @Model.semestreActual
        </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Promedio general</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.promedioGeneral.ToString("F2")</h3>
                </div>
                <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                    <i data-lucide="bar-chart-3" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Cursos matriculados</p>
                    <h3 class="mt-2 text-4xl font-extrabold text-slate-950">@Model.CursosMatriculados.Count</h3>
                </div>
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <i data-lucide="book-open" class="h-7 w-7"></i>
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Estado académico</p>
                    <h3 class="mt-2 text-2xl font-extrabold text-emerald-600">Activo</h3>
                </div>
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                    <i data-lucide="badge-check" class="h-7 w-7"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-950">Promedio de asignaturas</h3>
            <p class="mt-1 text-sm text-slate-500">Visualización general de tus calificaciones.</p>

            <div class="mt-6 h-72">
                <canvas id="graficoNotas"></canvas>
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-slate-950">Resumen de asignaturas</h3>
            <p class="mt-1 text-sm text-slate-500">Cursos matriculados y estado actual.</p>

            <div class="mt-6 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 text-slate-500">
                            <th class="py-3 font-semibold">Curso</th>
                            <th class="py-3 font-semibold">Estado</th>
                            <th class="py-3 font-semibold">Nota</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var curso in Model.CursosMatriculados)
                        {
                            <tr>
                                <td class="py-4">
                                    <p class="font-semibold text-slate-900">@curso.nombreCurso</p>
                                    <p class="text-xs text-slate-500">@curso.codigoCurso</p>
                                </td>
                                <td class="py-4">
                                    @if (curso.estadoNota == "Aprobado")
                                    {
                                        <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Aprobado</span>
                                    }
                                    else if (curso.estadoNota == "Desaprobado")
                                    {
                                        <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700">Desaprobado</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">@curso.estadoNota</span>
                                    }
                                </td>
                                <td class="py-4 font-bold text-slate-900">
                                    @curso.notaFinal.ToString("F2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const canvas = document.getElementById('graficoNotas');

            if (!canvas || typeof Chart === "undefined") {
                console.error("No se encontró el canvas o Chart.js no cargó.");
                return;
            }

            const labels = @Html.Raw(Json.Serialize(Model.CursosMatriculados.Select(c => c.nombreCurso).ToList()));
            const notas = @Html.Raw(Json.Serialize(Model.CursosMatriculados.Select(c => c.notaFinal).ToList()));

            const ctx = canvas.getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(37, 99, 235, 0.35)');
            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nota final',
                        data: notas,
                        fill: true,
                        backgroundColor: gradient,
                        borderColor: '#2563eb',
                        borderWidth: 3,
                        tension: 0.4,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#2563eb',
                        pointBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            padding: 12,
                            cornerRadius: 12,
                            displayColors: false,
                            callbacks: {
                                title: function (context) {
                                    return context[0].label;
                                },
                                label: function (context) {
                                    return 'Nota final: ' + Number(context.raw).toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                display: false
                            },
                            border: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            max: 20,
                            grid: {
                                color: '#e2e8f0'
                            },
                            ticks: {
                                color: '#64748b',
                                stepSize: 5
                            }
                        }
                    }
                }
            });
        });
    </script>
}