@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.AsistenciaEstudianteViewModel>

@{
    ViewData["Title"] = "Mis asistencias";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-amber-100">Expediente académico</p>
                <h2 class="mt-2 text-3xl font-extrabold">Mis asistencias</h2>
                <p class="mt-3 max-w-2xl text-amber-100">
                    Consulta tus registros de asistencia, tardanzas, justificaciones y observaciones por curso.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="calendar-check" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-6 text-blue-800">
            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay registros de asistencia</h3>
                    <p class="mt-1 text-sm">Cuando se registren asistencias, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-5">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Total registros</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-slate-950">@Model.Count</h3>
                    </div>
                    <div class="rounded-xl bg-slate-100 p-3 text-slate-600">
                        <i data-lucide="list-checks" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Presentes</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Count(a => a.Estado == "Presente")</h3>
                    </div>
                    <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                        <i data-lucide="check-circle-2" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Tardanzas</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-amber-600">@Model.Count(a => a.Estado == "Tardanza")</h3>
                    </div>
                    <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
                        <i data-lucide="clock" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Ausentes</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-red-600">@Model.Count(a => a.Estado == "Ausente")</h3>
                    </div>
                    <div class="rounded-xl bg-red-50 p-3 text-red-600">
                        <i data-lucide="x-circle" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Justificados</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-blue-600">@Model.Count(a => a.Estado == "Justificado")</h3>
                    </div>
                    <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                        <i data-lucide="file-check-2" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Registro de asistencias</h3>
                    <p class="mt-1 text-sm text-slate-500">Historial académico ordenado por curso y fecha.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-700">
                    <i data-lucide="calendar-days" class="h-4 w-4"></i>
                    @Model.Count registros
                </span>
            </div>

            <div class="max-h-[520px] overflow-auto">
                <table class="w-full min-w-[900px] text-left text-sm">
                    <thead class="sticky top-0 z-10">
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Fecha</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                            <th class="px-6 py-4 font-bold">Hora</th>
                            <th class="px-6 py-4 font-bold">Observaciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var asistencia in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                                            <i data-lucide="book-open" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@asistencia.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@asistencia.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="calendar" class="h-4 w-4 text-slate-400"></i>
                                        @asistencia.Fecha.ToString("dd/MM/yyyy")
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    @if (asistencia.Estado == "Presente")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            Presente
                                        </span>
                                    }
                                    else if (asistencia.Estado == "Ausente")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                            Ausente
                                        </span>
                                    }
                                    else if (asistencia.Estado == "Justificado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                                            <i data-lucide="file-check-2" class="h-3.5 w-3.5"></i>
                                            Justificado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                                            <i data-lucide="clock" class="h-3.5 w-3.5"></i>
                                            Tardanza
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    @(asistencia.HoraRegistro?.ToString(@"hh\:mm") ?? "00:00")
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    @(asistencia.Observacion ?? "Ninguna")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>