@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoEstudianteNotaViewModel>

@{
    ViewData["Title"] = "Mis cursos";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Catálogo académico</p>
                <h2 class="mt-2 text-3xl font-extrabold">Mis cursos matriculados</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Consulta tus asignaturas, docentes, créditos, promedio actual y acceso al detalle de notas.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="book-open" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No tienes cursos matriculados</h3>
                    <p class="mt-1 text-sm">Cuando tengas asignaturas registradas, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Cursos activos</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-slate-950">
                            @Model.Count(c => c.EstadoMatricula == "Activo")
                        </h3>
                    </div>
                    <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                        <i data-lucide="book-marked" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Créditos totales</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-slate-950">
                            @Model.Sum(c => c.Creditos)
                        </h3>
                    </div>
                    <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                        <i data-lucide="badge-check" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Promedio general</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">
                            @(Model.Any(c => c.PromedioActual > 0) ? Model.Where(c => c.PromedioActual > 0).Average(c => c.PromedioActual).ToString("F2") : "0.00")
                        </h3>
                    </div>
                    <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                        <i data-lucide="bar-chart-3" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Asignaturas matriculadas</h3>
                    <p class="mt-1 text-sm text-slate-500">Listado completo de cursos registrados en tu matrícula.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                    <i data-lucide="layers" class="h-4 w-4"></i>
                    @Model.Count cursos
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Docente</th>
                            <th class="px-6 py-4 font-bold">Créditos</th>
                            <th class="px-6 py-4 font-bold">Promedio</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                            <th class="px-6 py-4 text-center font-bold">Acciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var curso in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                            <i data-lucide="book-open" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@curso.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@curso.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="user-round" class="h-4 w-4 text-slate-400"></i>
                                        @curso.NombreDocente
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">
                                        @curso.Creditos créditos
                                    </span>
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.PromedioActual > 0)
                                    {
                                        <span class="text-lg font-extrabold text-slate-950">@curso.PromedioActual.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm font-semibold text-slate-400">--</span>
                                    }
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.EstadoMatricula == "Activo")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                            @curso.EstadoMatricula
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-5 text-right">
                                    <a asp-action="MisNotas" asp-controller="Estudiante" asp-route-matriculaId="@curso.MatriculaId"
                                       class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">
                                        <i data-lucide="chart-no-axes-column" class="h-4 w-4"></i>
                                        Notas
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>