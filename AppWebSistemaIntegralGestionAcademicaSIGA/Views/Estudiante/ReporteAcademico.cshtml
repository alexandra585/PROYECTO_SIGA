@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ReporteAcademicoViewModel

@{
    ViewData["Title"] = "Reporte académico";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Estudiante/ReporteAcademico.css" asp-append-version="true" />
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Reporte institucional</p>
                <h2 class="mt-2 text-3xl font-extrabold">Reporte académico</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Panel de indicadores de rendimiento académico, créditos aprobados y estado de cursos.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="file-text" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
                    <i data-lucide="user-round" class="h-7 w-7"></i>
                </div>

                <div>
                    <p class="text-sm font-semibold text-blue-600">Información del estudiante</p>
                    <h3 class="mt-1 text-2xl font-extrabold text-slate-950">@Model.NombreCompleto</h3>
                    <p class="mt-2 text-sm text-slate-500">@Model.Email</p>
                </div>
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Código</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.CodigoEstudiante</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Carrera</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.Carrera</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Semestre actual</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.SemestreActual</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Cursos registrados</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.Cursos.Count</p>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-slate-500">Promedio general</p>
            <div class="mt-4 flex items-end gap-2">
                <span class="text-5xl font-extrabold text-emerald-600">@Model.PromedioGeneral.ToString("F2")</span>
                <span class="pb-2 text-sm font-semibold text-slate-400">/ 20</span>
            </div>

            <div class="mt-6 h-3 overflow-hidden rounded-full bg-slate-100">
                <div class="h-full rounded-full bg-emerald-500" style="width:@((Model.PromedioGeneral / 20 * 100).ToString("F0"))%"></div>
            </div>

            <div class="mt-6 rounded-2xl bg-indigo-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Créditos aprobados</p>
                <p class="mt-1 text-3xl font-extrabold text-indigo-700">@Model.TotalCreditosAprobados</p>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
        <a asp-action="ExportarReporteExcel" asp-controller="Estudiante"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="file-spreadsheet" class="h-4 w-4"></i>
            Exportar Excel
        </a>

        <a asp-action="ExportarReportePDF" asp-controller="Estudiante"
           target="_blank"
           class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
            <i data-lucide="printer" class="h-4 w-4"></i>
            Imprimir PDF
        </a>

        <button onclick="abrirModalDrive()"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-600">
            <i data-lucide="cloud-upload" class="h-4 w-4"></i>
            Guardar en Drive
        </button>

        <div id="modalDrive" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 px-4">
            <div class="w-full max-w-md rounded-3xl bg-white p-8 shadow-2xl relative">
                <button onclick="cerrarModalDrive()"
                        class="absolute right-4 top-4 rounded-xl bg-slate-100 p-2 text-slate-500 transition hover:bg-slate-200">
                    <i data-lucide="x" class="h-5 w-5"></i>
                </button>

                <div class="text-center">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-100 text-blue-600">
                        <i data-lucide="cloud-upload" class="h-8 w-8"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-extrabold text-slate-950">Guardar en Google Drive</h3>
                    <p class="mt-2 text-sm text-slate-600">Sigue estos pasos para guardar tu reporte en Drive:</p>

                    <div class="mt-4 space-y-3 text-left">
                        <div class="flex items-start gap-3 rounded-xl bg-slate-50 p-3">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">1</span>
                            <p class="text-sm text-slate-700">Haz clic en <strong>"Nuevo"</strong> (+) en la esquina superior izquierda de su Google Drive.</p>
                        </div>
                        <div class="flex items-start gap-3 rounded-xl bg-slate-50 p-3">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">2</span>
                            <p class="text-sm text-slate-700">Selecciona <strong>"Subir archivo".</strong></p>
                        </div>
                        <div class="flex items-start gap-3 rounded-xl bg-slate-50 p-3">
                            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white">3</span>
                            <p class="text-sm text-slate-700">Elige el archivo <strong>PDF o Excel</strong> que descargaste.</p>
                        </div>
                    </div>

                    <button onclick="irADrive()"
                            class="mt-6 rounded-xl bg-blue-600 px-6 py-2 text-sm font-semibold text-white hover:bg-blue-700">
                            Ir a Drive
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Cursos.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay cursos registrados</h3>
                    <p class="mt-1 text-sm">Cuando tengas cursos registrados, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Rendimiento por curso</h3>
                    <p class="mt-1 text-sm text-slate-500">Resumen de créditos, promedio final y estado académico.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                    <i data-lucide="list-checks" class="h-4 w-4"></i>
                    @Model.Cursos.Count registros
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Créditos</th>
                            <th class="px-6 py-4 font-bold">Promedio final</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var curso in Model.Cursos)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                            <i data-lucide="book-open" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@curso.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@curso.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                        @curso.Creditos créditos
                                    </span>
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.PromedioFinal > 0)
                                    {
                                        if (curso.PromedioFinal >= 11)
                                        {
                                            <span class="text-lg font-extrabold text-emerald-600">@curso.PromedioFinal.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-lg font-extrabold text-red-600">@curso.PromedioFinal.ToString("F2")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-sm font-semibold text-slate-400">0.00</span>
                                    }
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.Estado == "Aprobado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                    else if (curso.Estado == "Desaprobado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                                            <i data-lucide="clock" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/Estudiante/ReporteAcademico.js" asp-append-version="true"></script>
}