@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ResumenNotaViewModel>

@{
    ViewData["Title"] = "Mis notas";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-emerald-100">Resumen académico</p>
                <h2 class="mt-2 text-3xl font-extrabold">Mis notas</h2>
                <p class="mt-3 max-w-2xl text-emerald-100">
                    Consulta el promedio final de tus asignaturas, créditos y estado académico.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="chart-line" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay notas registradas</h3>
                    <p class="mt-1 text-sm">Cuando tengas calificaciones, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Asignaturas</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-slate-950">@Model.Count</h3>
                    </div>
                    <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                        <i data-lucide="book-open" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Promedio general</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">
                            @(Model.Any(c => c.PromedioFinal > 0) ? Model.Where(c => c.PromedioFinal > 0).Average(c => c.PromedioFinal).ToString("F2") : "0.00")
                        </h3>
                    </div>
                    <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                        <i data-lucide="bar-chart-3" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Créditos totales</p>
                        <h3 class="mt-2 text-3xl font-extrabold text-indigo-600">@Model.Sum(c => c.Creditos)</h3>
                    </div>
                    <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                        <i data-lucide="badge-check" class="h-7 w-7"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Resumen por asignatura</h3>
                    <p class="mt-1 text-sm text-slate-500">Detalle de tus promedios finales por curso.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700">
                    <i data-lucide="list-checks" class="h-4 w-4"></i>
                    @Model.Count registros
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Curso</th>
                            <th class="px-6 py-4 font-bold">Créditos</th>
                            <th class="px-6 py-4 font-bold">Promedio final</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                            <th class="px-6 py-4 text-center font-bold">Acciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var curso in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                            <i data-lucide="book-open" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@curso.NombreCurso</p>
                                            <p class="mt-1 text-xs text-slate-500">@curso.CodigoCurso</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                        @curso.Creditos créditos
                                    </span>
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.PromedioFinal > 0)
                                    {
                                        if (curso.PromedioFinal >= 13)
                                        {
                                            <span class="text-lg font-extrabold text-emerald-600">@curso.PromedioFinal.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-lg font-extrabold text-red-600">@curso.PromedioFinal.ToString("F2")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-sm font-semibold text-slate-400">0.00</span>
                                    }
                                </td>

                                <td class="px-6 py-5">
                                    @if (curso.Estado == "Aprobado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                    else if (curso.Estado == "Desaprobado")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">
                                            <i data-lucide="clock" class="h-3.5 w-3.5"></i>
                                            @curso.Estado
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-5 text-right">
                                    <button type="button"
                                            class="btn-detalle inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
                                            data-curso="@curso.NombreCurso"
                                            data-codigo="@curso.CodigoCurso"
                                            data-promedio="@curso.PromedioFinal.ToString("F2")"
                                            data-estado="@curso.Estado"
                                            data-creditos="@curso.Creditos">
                                        <i data-lucide="info" class="h-4 w-4"></i>
                                        Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<div id="modalDetalle" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 px-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-sm font-semibold text-blue-600">Detalle del curso</p>
                <h3 class="mt-1 text-2xl font-extrabold text-slate-950" id="detalleCurso"></h3>
            </div>

            <button type="button" id="cerrarModal"
                    class="rounded-xl bg-slate-100 p-2 text-slate-500 hover:bg-slate-200">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>

        <div class="mt-6 space-y-4">
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase text-slate-500">Código del curso</p>
                <p class="mt-1 font-bold text-slate-900" id="detalleCodigo"></p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl bg-emerald-50 p-4">
                    <p class="text-xs font-semibold uppercase text-emerald-700">Promedio final</p>
                    <p class="mt-1 text-2xl font-extrabold text-emerald-700" id="detallePromedio"></p>
                </div>

                <div class="rounded-2xl bg-indigo-50 p-4">
                    <p class="text-xs font-semibold uppercase text-indigo-700">Créditos</p>
                    <p class="mt-1 text-2xl font-extrabold text-indigo-700" id="detalleCreditos"></p>
                </div>
            </div>

            <div class="rounded-2xl bg-blue-50 p-4">
                <p class="text-xs font-semibold uppercase text-blue-700">Estado</p>
                <p class="mt-1 font-bold text-blue-700" id="detalleEstado"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Estudiante/ResumenNotas.js" asp-append-version="true"></script>
}