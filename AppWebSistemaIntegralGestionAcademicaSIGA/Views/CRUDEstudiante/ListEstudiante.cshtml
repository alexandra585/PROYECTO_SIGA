@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.EstudianteListadoViewModel

@{
    ViewData["Title"] = "Lista de estudiantes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">

    <!-- =========================
     ENCABEZADO
========================== -->
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Gestión académica</p>
                <h2 class="mt-2 text-3xl font-extrabold">Gestión de estudiantes</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Administra estudiantes, carreras, semestre académico y estado de acceso.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="graduation-cap" class="h-8 w-8"></i>
            </div>
        </div>
    </div>


    <!-- =========================
     MENSAJE ÉXITO
========================== -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }


    <!-- =========================
     MENSAJE ERROR
========================== -->
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }


    <!-- =========================
     RESUMEN
========================== -->
    <div class="grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Activos</p>
            <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Estudiantes.Count(e => e.activo)</h3>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Inactivos</p>
            <h3 class="mt-2 text-3xl font-extrabold text-red-600">@Model.Estudiantes.Count(e => !e.activo)</h3>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Semestre I</p>
            <h3 class="mt-2 text-3xl font-extrabold text-blue-600">@Model.Estudiantes.Count(e => e.semestreActual == 1)</h3>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Semestre II</p>
            <h3 class="mt-2 text-3xl font-extrabold text-violet-600">@Model.Estudiantes.Count(e => e.semestreActual == 2)</h3>
        </div>
    </div>


    <!-- =========================
     BOTÓN NUEVO
========================== -->
    <div class="flex justify-end">
        <a asp-action="CreateEstudiante" asp-controller="CRUDEstudiante"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nuevo estudiante
        </a>
    </div>


    <!-- =========================
     FILTROS
========================== -->
    <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">

        <div class="border-b border-slate-200 px-6 py-5">

            <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i data-lucide="search" class="h-5 w-5"></i>
                </div>

                <div>
                    <h3 class="text-lg font-bold text-slate-950">
                        Buscar estudiantes
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        Utiliza los filtros para encontrar estudiantes específicos.
                    </p>
                </div>

            </div>

        </div>


        <form asp-action="ListEstudiante"
              asp-controller="CRUDEstudiante"
              method="get"
              class="p-6">

            <input type="hidden"
                   name="tamanioPagina"
                   value="@Model.Paginacion.TamanioPagina" />

            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">

                <!-- NOMBRE -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Nombre completo
                    </label>

                    <div class="relative">

                        <i data-lucide="user"
                           class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                        </i>

                        <input type="text"
                               name="nombre"
                               value="@Model.Nombre"
                               placeholder="Buscar por nombre..."
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    </div>
                </div>


                <!-- EMAIL -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Correo electrónico
                    </label>

                    <div class="relative">

                        <i data-lucide="mail"
                           class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                        </i>

                        <input type="text"
                               name="email"
                               value="@Model.Email"
                               placeholder="Buscar por correo..."
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    </div>
                </div>


                <!-- CÓDIGO -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Código de estudiante
                    </label>

                    <div class="relative">

                        <i data-lucide="badge"
                           class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                        </i>

                        <input type="text"
                               name="codigoEstudiante"
                               value="@Model.CodigoEstudiante"
                               placeholder="Ej. 20240001"
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    </div>
                </div>


                <!-- CARRERA -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Carrera
                    </label>

                    <div class="relative">

                        <i data-lucide="book-open"
                           class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
                        </i>

                        <input type="text"
                               name="nombreCarrera"
                               value="@Model.NombreCarrera"
                               placeholder="Buscar por carrera..."
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                    </div>
                </div>


                <!-- SEMESTRE -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Semestre
                    </label>

                    <select name="semestreActual"
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                        <option value="">Todos los semestres</option>

                        <option value="1"
                                selected="@(Model.SemestreActual == 1)">
                            Semestre I
                        </option>

                        <option value="2"
                                selected="@(Model.SemestreActual == 2)">
                            Semestre II
                        </option>

                    </select>
                </div>


                <!-- ESTADO -->
                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                        Estado
                    </label>

                    <select name="activo"
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                        <option value=""
                                selected="@(Model.Activo == null)">
                            Todos
                        </option>

                        <option value="true"
                                selected="@(Model.Activo == true)">
                            Activos
                        </option>

                        <option value="false"
                                selected="@(Model.Activo == false)">
                            Inactivos
                        </option>

                    </select>
                </div>

            </div>


            <!-- BOTONES -->
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">

                <a asp-action="ListEstudiante"
                   asp-controller="CRUDEstudiante"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">

                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i>

                    Limpiar filtros
                </a>

                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                    <i data-lucide="search" class="h-4 w-4"></i>

                    Buscar
                </button>

            </div>

        </form>

    </div>


    <!-- =========================
     RESULTADOS
========================== -->
    @if (!Model.Estudiantes.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">

            <div class="flex items-start gap-4">

                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>

                <div>

                    <h3 class="font-bold">
                        No se encontraron estudiantes
                    </h3>

                    <p class="mt-1 text-sm">
                        No existen estudiantes que coincidan con los filtros seleccionados.
                    </p>

                </div>

            </div>

        </div>
    }
    else
    {

        <!-- =========================
         TABLA
    ========================== -->
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">

            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <div>

                    <h3 class="text-lg font-bold text-slate-950">
                        Listado de estudiantes
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        Mostrando
                        <span class="font-semibold text-slate-700">
                            @Model.Estudiantes.Count
                        </span>
                        de
                        <span class="font-semibold text-slate-700">
                            @Model.Paginacion.TotalRegistros
                        </span>
                        estudiantes.
                    </p>

                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">

                    <i data-lucide="users" class="h-4 w-4"></i>

                    Página @Model.Paginacion.Pagina de @Model.Paginacion.TotalPaginas

                </span>

            </div>


            <div class="overflow-x-auto">

                <table class="w-full min-w-[1050px] text-left text-sm">

                    <thead>

                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">

                            <th class="px-6 py-4 font-bold">
                                Estudiante
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Correo
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Carrera
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Semestre
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Estado
                            </th>

                            <th class="px-6 py-4 text-right font-bold">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-100">

                        @foreach (var estudiante in Model.Estudiantes)
                        {
                            <tr class="transition hover:bg-slate-50">

                                <!-- ESTUDIANTE -->
                                <td class="px-6 py-5">

                                    <div class="flex items-center gap-3">

                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                                            <i data-lucide="graduation-cap"
                                               class="h-5 w-5">
                                            </i>

                                        </div>

                                        <div>

                                            <p class="font-bold text-slate-950">
                                                @estudiante.nombreCompleto
                                            </p>

                                            <p class="mt-1 text-xs text-slate-500">
                                                @estudiante.codigoEstudiante
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- EMAIL -->
                                <td class="px-6 py-5 text-slate-600">

                                    <div class="flex items-center gap-2">

                                        <i data-lucide="mail"
                                           class="h-4 w-4 text-slate-400">
                                        </i>

                                        @estudiante.email

                                    </div>

                                </td>


                                <!-- CARRERA -->
                                <td class="px-6 py-5">

                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">

                                        @estudiante.nombreCarrera

                                    </span>

                                </td>


                                <!-- SEMESTRE -->
                                <td class="px-6 py-5 text-slate-600">

                                    <div class="flex items-center gap-2">

                                        <i data-lucide="calendar-days"
                                           class="h-4 w-4 text-slate-400">
                                        </i>

                                        Semestre @estudiante.semestreActual

                                    </div>

                                </td>


                                <!-- ESTADO -->
                                <td class="px-6 py-5">

                                    @if (estudiante.activo)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">

                                            <i data-lucide="check-circle-2"
                                               class="h-3.5 w-3.5">
                                            </i>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">

                                            <i data-lucide="x-circle"
                                               class="h-3.5 w-3.5">
                                            </i>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="px-6 py-5">

                                    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">

                                        <a asp-action="EditEstudiante"
                                           asp-controller="CRUDEstudiante"
                                           asp-route-id="@estudiante.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">

                                            <i data-lucide="edit-3"
                                               class="h-4 w-4">
                                            </i>

                                            Editar

                                        </a>


                                        <a asp-action="DeleteEstudiante"
                                           asp-controller="CRUDEstudiante"
                                           asp-route-id="@estudiante.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">

                                            <i data-lucide="trash-2"
                                               class="h-4 w-4">
                                            </i>

                                            Eliminar

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =========================
             PAGINACIÓN
        ========================== -->
            <div class="flex flex-col gap-4 border-t border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <!-- Información -->
                <div class="text-sm text-slate-500">

                    @if (Model.Paginacion.TotalRegistros > 0)
                    {
                        var primerRegistro =
                            ((Model.Paginacion.Pagina - 1)
                            * Model.Paginacion.TamanioPagina) + 1;

                        var ultimoRegistro =
                            Math.Min(
                                Model.Paginacion.Pagina
                                * Model.Paginacion.TamanioPagina,
                                Model.Paginacion.TotalRegistros
                            );

                        <span>
                            Mostrando
                            <span class="font-semibold text-slate-700">
                                @primerRegistro
                            </span>
                            -
                            <span class="font-semibold text-slate-700">
                                @ultimoRegistro
                            </span>
                            de
                            <span class="font-semibold text-slate-700">
                                @Model.Paginacion.TotalRegistros
                            </span>
                            registros
                        </span>
                    }
                    else
                    {
                        <span>No hay registros</span>
                    }

                </div>


                <!-- Botones -->
                @if (Model.Paginacion.TotalPaginas > 1)
                {
                    <div class="flex items-center gap-1">

                        <!-- ANTERIOR -->
                        @if (Model.Paginacion.TienePaginaAnterior)
                        {
                            <a asp-action="ListEstudiante"
                               asp-controller="CRUDEstudiante"
                               asp-route-pagina="@(Model.Paginacion.Pagina - 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-codigoEstudiante="@Model.CodigoEstudiante"
                               asp-route-nombreCarrera="@Model.NombreCarrera"
                               asp-route-semestreActual="@Model.SemestreActual"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </span>
                        }


                        <!-- PRIMERA PÁGINA -->
                        @if (Model.Paginacion.Pagina == 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                1
                            </span>
                        }
                        else
                        {
                            <a asp-action="ListEstudiante"
                               asp-controller="CRUDEstudiante"
                               asp-route-pagina="1"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-codigoEstudiante="@Model.CodigoEstudiante"
                               asp-route-nombreCarrera="@Model.NombreCarrera"
                               asp-route-semestreActual="@Model.SemestreActual"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">
                                1
                            </a>
                        }


                        @{
                            int paginaActual = Model.Paginacion.Pagina;
                            int totalPaginas = Model.Paginacion.TotalPaginas;

                            // Mostrar páginas cercanas a la actual
                            int inicio = Math.Max(2, paginaActual - 1);
                            int fin = Math.Min(totalPaginas - 1, paginaActual + 1);
                        }


                        <!-- ... IZQUIERDO -->
                        @if (inicio > 2)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- PÁGINAS INTERMEDIAS -->
                        @for (int pagina = inicio; pagina <= fin; pagina++)
                        {
                            if (pagina == paginaActual)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @pagina
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListEstudiante"
                                   asp-controller="CRUDEstudiante"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-codigoEstudiante="@Model.CodigoEstudiante"
                                   asp-route-nombreCarrera="@Model.NombreCarrera"
                                   asp-route-semestreActual="@Model.SemestreActual"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @pagina

                                </a>
                            }
                        }


                        <!-- ... DERECHO -->
                        @if (fin < totalPaginas - 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- ÚLTIMA PÁGINA -->
                        @if (totalPaginas > 1)
                        {
                            if (paginaActual == totalPaginas)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @totalPaginas
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListEstudiante"
                                   asp-controller="CRUDEstudiante"
                                   asp-route-pagina="@totalPaginas"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-codigoEstudiante="@Model.CodigoEstudiante"
                                   asp-route-nombreCarrera="@Model.NombreCarrera"
                                   asp-route-semestreActual="@Model.SemestreActual"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @totalPaginas

                                </a>
                            }
                        }


                        <!-- SIGUIENTE -->
                        @if (Model.Paginacion.TienePaginaSiguiente)
                        {
                            <a asp-action="ListEstudiante"
                               asp-controller="CRUDEstudiante"
                               asp-route-pagina="@(Model.Paginacion.Pagina + 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-codigoEstudiante="@Model.CodigoEstudiante"
                               asp-route-nombreCarrera="@Model.NombreCarrera"
                               asp-route-semestreActual="@Model.SemestreActual"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </span>
                        }

                    </div>
                }

            </div>
        </div>
    }

</section>
