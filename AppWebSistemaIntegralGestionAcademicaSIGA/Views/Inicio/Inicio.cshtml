@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="inicio" class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-blue-50 via-white to-indigo-50"></div>
    <div class="absolute -right-32 -top-32 -z-10 h-96 w-96 rounded-full bg-blue-200/40 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 -z-10 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"></div>

    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-2 lg:items-center">
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700">
                <i data-lucide="sparkles" class="h-4 w-4"></i>
                Plataforma académica integral
            </span>

            <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-950 md:text-6xl">
                Gestiona tu institución desde un solo lugar
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
                SIGA centraliza usuarios, secretarías, docentes, estudiantes, apoderados, cursos, asistencias, notas y reportes en una plataforma moderna,
                segura y fácil de utilizar.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a asp-action="IniciarSesion" asp-controller="Auth"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-blue-700">
                    Iniciar sesión
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </a>
                <a href="#modulos"
                   class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 hover:bg-slate-100">
                    Ver módulos
                </a>
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl">
            <div class="rounded-2xl bg-slate-950 p-5 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-300">Panel académico</p>
                        <h3 class="mt-1 text-2xl font-bold">Resumen institucional</h3>
                    </div>
                    <i data-lucide="layout-dashboard" class="h-8 w-8 text-blue-300"></i>
                </div>

                <div class="mt-6 grid gap-4 sm:grid-cols-3">
                    <div class="rounded-xl bg-white/10 p-4">
                        <p class="text-2xl font-bold">+120</p>
                        <p class="text-xs text-slate-300">Estudiantes</p>
                    </div>
                    <div class="rounded-xl bg-white/10 p-4">
                        <p class="text-2xl font-bold">+18</p>
                        <p class="text-xs text-slate-300">Docentes</p>
                    </div>
                    <div class="rounded-xl bg-white/10 p-4">
                        <p class="text-2xl font-bold">+12</p>
                        <p class="text-xs text-slate-300">Cursos</p>
                    </div>
                </div>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl bg-blue-50 p-5">
                    <i data-lucide="users" class="h-8 w-8 text-blue-600"></i>
                    <h3 class="mt-4 font-bold">Usuarios</h3>
                    <p class="mt-2 text-sm text-slate-600">Control de accesos por rol.</p>
                </div>
                <div class="rounded-2xl bg-indigo-50 p-5">
                    <i data-lucide="book-open" class="h-8 w-8 text-indigo-600"></i>
                    <h3 class="mt-4 font-bold">Cursos</h3>
                    <p class="mt-2 text-sm text-slate-600">Asignaciones académicas claras.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="modulos" class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Módulos principales</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">Todo lo académico en una plataforma</h2>
        <p class="mt-4 text-slate-600">Administra las áreas más importantes de la institución con herramientas simples y ordenadas.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="users-round" class="h-8 w-8 text-blue-600"></i>
            <h3 class="mt-4 font-bold">Usuarios</h3>
            <p class="mt-2 text-sm text-slate-600">Registra y administra cuentas del sistema.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="clipboard-list" class="h-8 w-8 text-violet-600"></i>
            <h3 class="mt-4 font-bold">Secretarías</h3>
            <p class="mt-2 text-sm text-slate-600">Gestión administrativa y de asignaciones.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="school" class="h-8 w-8 text-indigo-600"></i>
            <h3 class="mt-4 font-bold">Docentes</h3>
            <p class="mt-2 text-sm text-slate-600">Gestiona información del personal docente.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="graduation-cap" class="h-8 w-8 text-emerald-600"></i>
            <h3 class="mt-4 font-bold">Estudiantes</h3>
            <p class="mt-2 text-sm text-slate-600">Controla datos académicos de estudiantes.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="users" class="h-8 w-8 text-cyan-600"></i>
            <h3 class="mt-4 font-bold">Apoderados</h3>
            <p class="mt-2 text-sm text-slate-600">Administra tutores y vínculo con estudiantes.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="book-marked" class="h-8 w-8 text-amber-600"></i>
            <h3 class="mt-4 font-bold">Cursos</h3>
            <p class="mt-2 text-sm text-slate-600">Organiza cursos, docentes y matrículas.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="link-2" class="h-8 w-8 text-rose-600"></i>
            <h3 class="mt-4 font-bold">Asignaciones</h3>
            <p class="mt-2 text-sm text-slate-600">Curso-docente, matrículas y apoderados.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <i data-lucide="clipboard-check" class="h-8 w-8 text-teal-600"></i>
            <h3 class="mt-4 font-bold">Notas y asistencias</h3>
            <p class="mt-2 text-sm text-slate-600">Registro académico y seguimiento diario.</p>
        </div>
    </div>
</section>

<section id="beneficios" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div>
                <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Beneficios</span>
                <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">Menos procesos manuales, más control académico</h2>
                <p class="mt-5 text-slate-600">
                    SIGA ayuda a centralizar la información, reducir errores y mejorar el acceso a datos importantes para cada rol.
                </p>
            </div>

            <div class="grid gap-4">
                <div class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                    <i data-lucide="shield-check" class="h-7 w-7 text-blue-600"></i>
                    <div>
                        <h3 class="font-bold">Acceso seguro por roles</h3>
                        <p class="mt-1 text-sm text-slate-600">Cada usuario visualiza solo la información que le corresponde.</p>
                    </div>
                </div>
                <div class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                    <i data-lucide="clock" class="h-7 w-7 text-blue-600"></i>
                    <div>
                        <h3 class="font-bold">Ahorro de tiempo</h3>
                        <p class="mt-1 text-sm text-slate-600">Registros, consultas y reportes más rápidos.</p>
                    </div>
                </div>
                <div class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                    <i data-lucide="database" class="h-7 w-7 text-blue-600"></i>
                    <div>
                        <h3 class="font-bold">Información centralizada</h3>
                        <p class="mt-1 text-sm text-slate-600">Los datos académicos se mantienen ordenados y disponibles.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="flujo" class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Flujo del sistema</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">Un proceso simple y ordenado</h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 font-bold text-white">1</div>
            <h3 class="mt-5 font-bold">Registrar</h3>
            <p class="mt-2 text-sm text-slate-600">Crea usuarios, docentes, estudiantes y cursos.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 font-bold text-white">2</div>
            <h3 class="mt-5 font-bold">Asignar</h3>
            <p class="mt-2 text-sm text-slate-600">Relaciona docentes y estudiantes con sus cursos.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 font-bold text-white">3</div>
            <h3 class="mt-5 font-bold">Evaluar</h3>
            <p class="mt-2 text-sm text-slate-600">Registra notas y asistencias de forma organizada.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 font-bold text-white">4</div>
            <h3 class="mt-5 font-bold">Consultar</h3>
            <p class="mt-2 text-sm text-slate-600">Genera reportes y revisa el avance académico.</p>
        </div>
    </div>
</section>

<section id="roles" class="bg-slate-950 py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto max-w-2xl text-center">
            <span class="text-sm font-semibold uppercase tracking-wide text-blue-300">Roles del sistema</span>
            <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">Una experiencia para cada usuario</h2>
            <p class="mt-4 text-slate-300">Cada rol cuenta con funciones adaptadas a sus responsabilidades.</p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">
                <i data-lucide="briefcase-business" class="h-9 w-9 text-blue-300"></i>
                <h3 class="mt-5 text-xl font-bold">Director</h3>
                <p class="mt-3 text-sm leading-6 text-slate-300">Gestiona usuarios, personal, cursos y la visión general de la institución.</p>
            </div>

            <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">
                <i data-lucide="clipboard-list" class="h-9 w-9 text-violet-300"></i>
                <h3 class="mt-5 text-xl font-bold">Secretaria</h3>
                <p class="mt-3 text-sm leading-6 text-slate-300">Administra asignaciones académicas, matrículas y vínculos apoderado-estudiante.</p>
            </div>

            <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">
                <i data-lucide="school" class="h-9 w-9 text-indigo-300"></i>
                <h3 class="mt-5 text-xl font-bold">Docente</h3>
                <p class="mt-3 text-sm leading-6 text-slate-300">Consulta cursos asignados, registra notas, asistencias y reportes de curso.</p>
            </div>

            <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">
                <i data-lucide="user-round" class="h-9 w-9 text-emerald-300"></i>
                <h3 class="mt-5 text-xl font-bold">Estudiante</h3>
                <p class="mt-3 text-sm leading-6 text-slate-300">Visualiza cursos, notas, asistencias y reporte académico personal.</p>
            </div>

            <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">
                <i data-lucide="users-round" class="h-9 w-9 text-cyan-300"></i>
                <h3 class="mt-5 text-xl font-bold">Apoderado</h3>
                <p class="mt-3 text-sm leading-6 text-slate-300">Consulta el avance académico de los estudiantes a su cargo.</p>
            </div>
        </div>
    </div>
</section>

<section id="cobertura" class="pt-20 pb-0">
    <div class="mx-auto max-w-7xl px-6">
        <div class="mx-auto max-w-2xl text-center">
            <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Cobertura institucional</span>
            <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">Pensado para toda la comunidad educativa</h2>
            <p class="mt-4 text-slate-600">Desde la dirección hasta el hogar, cada actor tiene su espacio en SIGA.</p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
            <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-blue-700">
                    <i data-lucide="building-2" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 text-lg font-bold text-slate-950">Dirección y administración</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    Director y secretaría coordinan personal, asignaciones y el día a día académico sin depender de hojas sueltas.
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-700">
                    <i data-lucide="presentation" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 text-lg font-bold text-slate-950">Aula y docentes</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    Los docentes concentran cursos, notas y asistencias en un solo panel, listo para reportar avances.
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-100 text-cyan-700">
                    <i data-lucide="home" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 text-lg font-bold text-slate-950">Familia y estudiantes</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                    Estudiantes y apoderados consultan información clara del rendimiento y la asistencia.
                </p>
            </div>
        </div>
    </div>
</section>

<section id="estadisticas" class="mx-auto max-w-7xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Indicadores</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">Métricas académicas del SIGA</h2>
        <p class="mt-4 text-slate-600">
            Datos clave que reflejan el alcance y la cobertura del sistema en la institución educativa.
        </p>
    </div>
    <div class="mt-12 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-10">
        <div class="grid gap-8 md:grid-cols-4">
            <div class="text-center">
                <p class="text-4xl font-extrabold text-blue-600">5</p>
                <p class="mt-2 text-sm font-medium text-slate-600">Roles del sistema</p>
            </div>
            <div class="text-center">
                <p class="text-4xl font-extrabold text-blue-600">8+</p>
                <p class="mt-2 text-sm font-medium text-slate-600">Módulos académicos</p>
            </div>
            <div class="text-center">
                <p class="text-4xl font-extrabold text-blue-600">24/7</p>
                <p class="mt-2 text-sm font-medium text-slate-600">Acceso al sistema</p>
            </div>
            <div class="text-center">
                <p class="text-4xl font-extrabold text-blue-600">100%</p>
                <p class="mt-2 text-sm font-medium text-slate-600">Gestión centralizada</p>
            </div>
        </div>
    </div>
</section>

<section id="contacto" class="mx-auto max-w-7xl px-6 pb-24">
    <div class="mx-auto mb-12 max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-blue-600">Contacto y acceso</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-950 md:text-4xl">¿Listo para dar el siguiente paso?</h2>
        <p class="mt-4 text-slate-600">
            Comunicate con nosotros para gestionar tu educación de una manera rápida y sencilla.
        </p>
    </div>

    <div class="relative overflow-hidden rounded-3xl bg-blue-600 p-10 text-center text-white shadow-xl">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/20 blur-3xl"></div>
        <div class="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-300/20 blur-3xl"></div>

        <div class="relative mx-auto max-w-2xl">
            <i data-lucide="rocket" class="mx-auto h-12 w-12"></i>
            <h2 class="mt-5 text-3xl font-extrabold md:text-4xl">Empieza a gestionar tu institución de forma inteligente</h2>
            <p class="mt-4 text-blue-100">
                Ingresa al sistema y accede a las herramientas académicas según tu rol.
            </p>
            <div class="mt-8">
                <a asp-action="IniciarSesion" asp-controller="Auth"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-blue-700 shadow-sm hover:bg-blue-50">
                    Iniciar sesión
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </a>
            </div>
        </div>
    </div>
</section>
