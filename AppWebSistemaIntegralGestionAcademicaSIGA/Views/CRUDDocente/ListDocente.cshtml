@model List<AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.DocenteViewModel>

@{
    ViewData["Title"] = "Lista de docentes";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Gestión académica</p>
                <h2 class="mt-2 text-3xl font-extrabold">Gestión de docentes</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Administra docentes, especialidades, grado académico y estado de cuenta.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="school" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="grid w-full gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Activos</p>
                <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Count(d => d.activo)</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Inactivos</p>
                <h3 class="mt-2 text-3xl font-extrabold text-red-600">@Model.Count(d => !d.activo)</h3>
            </div>
        </div>
    </div>

    <div class="flex justify-end">
        <a asp-action="CreateDocente" asp-controller="CRUDDocente"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nuevo docente
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">
            <div class="flex items-start gap-4">
                <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>
                <div>
                    <h3 class="font-bold">No hay docentes registrados</h3>
                    <p class="mt-1 text-sm">Cuando registres docentes, aparecerán en esta sección.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Listado de docentes</h3>
                    <p class="mt-1 text-sm text-slate-500">Consulta y administra docentes registrados.</p>
                </div>

                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                    <i data-lucide="users" class="h-4 w-4"></i>
                    @Model.Count docentes
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[1000px] text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <th class="px-6 py-4 font-bold">Docente</th>
                            <th class="px-6 py-4 font-bold">Correo</th>
                            <th class="px-6 py-4 font-bold">Especialidad</th>
                            <th class="px-6 py-4 font-bold">Grado académico</th>
                            <th class="px-6 py-4 font-bold">Estado</th>
                            <th class="px-6 py-4 text-right font-bold">Acciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @foreach (var docente in Model)
                        {
                            <tr class="transition hover:bg-slate-50">
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                            <i data-lucide="school" class="h-5 w-5"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-950">@docente.nombreCompleto</p>
                                            <p class="mt-1 text-xs text-slate-500">ID: @docente.id</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="mail" class="h-4 w-4 text-slate-400"></i>
                                        @docente.email
                                    </div>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">
                                        @docente.especialidad
                                    </span>
                                </td>

                                <td class="px-6 py-5 text-slate-600">
                                    @docente.gradoAcademico
                                </td>

                                <td class="px-6 py-5">
                                    @if (docente.activo)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">
                                            <i data-lucide="check-circle-2" class="h-3.5 w-3.5"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                                            <i data-lucide="x-circle" class="h-3.5 w-3.5"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-5">
                                    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
                                        <a asp-action="EditDocente" asp-controller="CRUDDocente" asp-route-id="@docente.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">
                                            <i data-lucide="edit-3" class="h-4 w-4"></i>
                                            Editar
                                        </a>

                                        <a asp-action="DeleteDocente" asp-controller="CRUDDocente" asp-route-id="@docente.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>