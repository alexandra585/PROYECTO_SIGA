@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoViewModel

@{
    ViewData["Title"] = "Eliminar curso";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-red-600 to-rose-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-red-100">Gestión de cursos</p>
                <h2 class="mt-2 text-3xl font-extrabold">Eliminar curso</h2>
                <p class="mt-3 max-w-2xl text-red-100">
                    Confirma el retiro del curso seleccionado del sistema académico.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="trash-2" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-amber-800">
        <div class="flex items-start gap-3">
            <i data-lucide="triangle-alert" class="mt-0.5 h-6 w-6"></i>
            <div>
                <h3 class="font-bold">Advertencia importante</h3>
                <p class="mt-1 text-sm">
                    ¿Está seguro que desea eliminar este curso? Esta acción puede afectar asignaciones existentes.
                </p>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Datos del curso</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Revisa la información antes de confirmar la eliminación.
                </p>
            </div>

            <div class="mt-6 grid gap-5 md:grid-cols-2">
                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Código del curso</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.codigoCurso</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Nombre del curso</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.nombreCurso</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Créditos</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.creditos</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Horas teóricas</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.horasTeoricas</p>
                </div>

                <div class="rounded-2xl bg-slate-50 p-4 md:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Horas prácticas</p>
                    <p class="mt-1 font-bold text-slate-900">@Model.horasPracticas</p>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" asp-controller="CRUDCurso" method="post" class="mt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id" />
                <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                    <a asp-action="ListCurso" asp-controller="CRUDCurso"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                        Confirmar eliminación
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-red-200 bg-red-50 p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-600">
                    <i data-lucide="shield-alert" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-red-900">Acción delicada</h3>
                <p class="mt-2 text-sm leading-6 text-red-700">
                    Eliminar un curso puede afectar asignaciones de docentes, matrículas y reportes relacionados.
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
                    <i data-lucide="info" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-slate-950">Recomendación</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Verifica que el curso seleccionado no tenga asignaciones activas antes de continuar.
                </p>
            </div>
        </div>
    </div>
</section>