@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoListadoViewModel

@{
    ViewData["Title"] = "Lista de cursos";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <!-- ==========================================
     CABECERA
     ========================================== -->
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Gestión académica</p>
                <h2 class="mt-2 text-3xl font-extrabold">Gestión de cursos</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Administra las asignaturas, créditos y carga horaria del sistema académico.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="book-open" class="h-8 w-8"></i>
            </div>
        </div>
    </div>


    <!-- ==========================================
     MENSAJE DE ÉXITO
     ========================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }


    <!-- ==========================================
     MENSAJE DE ERROR
     ========================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }


    <!-- ==========================================
     FILTROS
     ========================================== -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

        <div class="mb-5">

            <h3 class="text-lg font-bold text-slate-950">
                Filtros de búsqueda
            </h3>

            <p class="mt-1 text-sm text-slate-500">
                Filtra los cursos según su código, nombre o cantidad de créditos.
            </p>

        </div>


        <form asp-action="ListCurso"
              asp-controller="CRUDCurso"
              method="get"
              class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">


            <!-- CÓDIGO -->
            <div>

                <label class="mb-1 block text-sm font-semibold text-slate-700">
                    Código del curso
                </label>

                <input type="text"
                       name="codigoCurso"
                       value="@Model.CodigoCurso"
                       placeholder="Ej. MAT101"
                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

            </div>


            <!-- NOMBRE -->
            <div>

                <label class="mb-1 block text-sm font-semibold text-slate-700">
                    Nombre del curso
                </label>

                <input type="text"
                       name="nombreCurso"
                       value="@Model.NombreCurso"
                       placeholder="Ej. Matemática"
                       class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

            </div>


            <!-- CRÉDITOS -->
            <div>

                <label class="mb-1 block text-sm font-semibold text-slate-700">
                    Créditos
                </label>

                <select name="creditos"
                        class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                    @if (Model.Creditos == null)
                    {
                        <option value="" selected>
                            Todos
                        </option>
                    }
                    else
                    {
                        <option value="">
                            Todos
                        </option>
                    }

                    @for (int i = 0; i <= 7; i++)
                    {
                        if (Model.Creditos == i)
                        {
                            <option value="@i" selected>
                                @i créditos
                            </option>
                        }
                        else
                        {
                            <option value="@i">
                                @i créditos
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- BOTONES -->
            <div class="flex items-end gap-2">

                <button type="submit"
                        class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                    <i data-lucide="search"
                       class="h-4 w-4"></i>

                    Buscar

                </button>


                <a asp-action="ListCurso"
                   asp-controller="CRUDCurso"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">

                    <i data-lucide="rotate-ccw"
                       class="h-4 w-4"></i>

                    Limpiar

                </a>

            </div>


            <!-- TAMAÑO DE PÁGINA -->
            <input type="hidden"
                   name="tamanioPagina"
                   value="@Model.Paginacion.TamanioPagina" />

        </form>

    </div>


    <!-- ==========================================
     ESTADÍSTICAS
     ========================================== -->
    <div class="grid gap-6 md:grid-cols-3">

        <!-- CRÉDITOS -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Créditos totales</p>
            <h3 class="mt-2 text-3xl font-extrabold text-indigo-600">@Model.Cursos.Sum(c => c.creditos)</h3>
        </div>


        <!-- HORAS TEÓRICAS -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Horas teóricas</p>
            <h3 class="mt-2 text-3xl font-extrabold text-blue-600">@Model.Cursos.Sum(c => c.horasTeoricas)</h3>
        </div>


        <!-- HORAS PRÁCTICAS -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-slate-500">Horas prácticas</p>
            <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Cursos.Sum(c => c.horasPracticas)</h3>
        </div>
    </div>


    <!-- ==========================================
     NUEVO CURSO
     ========================================== -->
    <div class="flex justify-end">
        <a asp-action="CreateCurso" asp-controller="CRUDCurso"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nuevo curso
        </a>
    </div>


    <!-- ==========================================
     SIN RESULTADOS
     ========================================== -->
    @if (!Model.Cursos.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">

            <div class="flex items-start gap-4">

                <i data-lucide="info"
                   class="mt-0.5 h-6 w-6"></i>

                <div>

                    <h3 class="font-bold">
                        No hay cursos registrados
                    </h3>

                    <p class="mt-1 text-sm">
                        No se encontraron cursos con los filtros seleccionados.
                    </p>

                </div>

            </div>

        </div>
    }
    else
    {

        <!-- ==========================================
         LISTADO
         ========================================== -->
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">


            <!-- CABECERA -->
            <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <div>

                    <h3 class="text-lg font-bold text-slate-950">
                        Listado de cursos
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        Consulta y administra las asignaturas registradas.
                    </p>

                </div>


                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">

                    <i data-lucide="layers"
                       class="h-4 w-4"></i>

                    @Model.Paginacion.TotalRegistros cursos

                </span>

            </div>


            <!-- TABLA -->
            <div class="overflow-x-auto">

                <table class="w-full min-w-[950px] text-left text-sm">

                    <thead>

                        <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">

                            <th class="px-6 py-4 font-bold">
                                Curso
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Créditos
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Horas teóricas
                            </th>

                            <th class="px-6 py-4 font-bold">
                                Horas prácticas
                            </th>

                            <th class="px-6 py-4 text-right font-bold">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-100">

                        @foreach (var curso in Model.Cursos)
                        {

                            <tr class="transition hover:bg-slate-50">


                                <!-- CURSO -->
                                <td class="px-6 py-5">

                                    <div class="flex items-center gap-3">

                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                                            <i data-lucide="book-open"
                                               class="h-5 w-5"></i>

                                        </div>


                                        <div>

                                            <p class="font-bold text-slate-950">
                                                @curso.nombreCurso
                                            </p>

                                            <p class="mt-1 text-xs text-slate-500">
                                                @curso.codigoCurso
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- CRÉDITOS -->
                                <td class="px-6 py-5">

                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">

                                        @curso.creditos créditos

                                    </span>

                                </td>


                                <!-- HORAS TEÓRICAS -->
                                <td class="px-6 py-5 text-slate-600">

                                    <div class="flex items-center gap-2">

                                        <i data-lucide="clock-3"
                                           class="h-4 w-4 text-slate-400"></i>

                                        @curso.horasTeoricas horas

                                    </div>

                                </td>


                                <!-- HORAS PRÁCTICAS -->
                                <td class="px-6 py-5 text-slate-600">

                                    <div class="flex items-center gap-2">

                                        <i data-lucide="flask-conical"
                                           class="h-4 w-4 text-slate-400"></i>

                                        @curso.horasPracticas horas

                                    </div>

                                </td>


                                <!-- ACCIONES -->
                                <td class="px-6 py-5">

                                    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">

                                        <a asp-action="EditCurso"
                                           asp-controller="CRUDCurso"
                                           asp-route-id="@curso.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">

                                            <i data-lucide="edit-3"
                                               class="h-4 w-4"></i>

                                            Editar

                                        </a>


                                        <a asp-action="DeleteCurso"
                                           asp-controller="CRUDCurso"
                                           asp-route-id="@curso.id"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">

                                            <i data-lucide="trash-2"
                                               class="h-4 w-4"></i>

                                            Eliminar

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>


            <!-- ==========================================
             PAGINACIÓN
             ========================================== -->
            <div class="flex flex-col gap-4 border-t border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <!-- Información -->
                <div class="text-sm text-slate-500">

                    @if (Model.Paginacion.TotalRegistros > 0)
                    {
                        var primerRegistro =
                            ((Model.Paginacion.Pagina - 1)
                            * Model.Paginacion.TamanioPagina) + 1;

                        var ultimoRegistro =
                            Math.Min(
                                Model.Paginacion.Pagina
                                * Model.Paginacion.TamanioPagina,
                                Model.Paginacion.TotalRegistros
                            );

                        <span>
                            Mostrando
                            <span class="font-semibold text-slate-700">
                                @primerRegistro
                            </span>
                            -
                            <span class="font-semibold text-slate-700">
                                @ultimoRegistro
                            </span>
                            de
                            <span class="font-semibold text-slate-700">
                                @Model.Paginacion.TotalRegistros
                            </span>
                            registros
                        </span>
                    }
                    else
                    {
                        <span>No hay registros</span>
                    }

                </div>


                <!-- Botones -->
                @if (Model.Paginacion.TotalPaginas > 1)
                {
                    <div class="flex items-center gap-1">

                        <!-- ANTERIOR -->
                        @if (Model.Paginacion.TienePaginaAnterior)
                        {
                            <a asp-action="ListCurso"
                               asp-controller="CRUDCurso"
                               asp-route-pagina="@(Model.Paginacion.Pagina - 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-codigoCurso="@Model.CodigoCurso"
                               asp-route-nombreCurso="@Model.NombreCurso"
                               asp-route-creditos="@Model.Creditos"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </span>
                        }


                        <!-- PRIMERA PÁGINA -->
                        @if (Model.Paginacion.Pagina == 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                1
                            </span>
                        }
                        else
                        {
                            <a asp-action="ListCurso"
                               asp-controller="CRUDCurso"
                               asp-route-pagina="1"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-codigoCurso="@Model.CodigoCurso"
                               asp-route-nombreCurso="@Model.NombreCurso"
                               asp-route-creditos="@Model.Creditos"
                               class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                1

                            </a>
                        }


                        @{
                            int paginaActual = Model.Paginacion.Pagina;
                            int totalPaginas = Model.Paginacion.TotalPaginas;

                            // Mostrar páginas cercanas a la actual
                            int inicio = Math.Max(2, paginaActual - 1);
                            int fin = Math.Min(totalPaginas - 1, paginaActual + 1);
                        }


                        <!-- ... IZQUIERDO -->
                        @if (inicio > 2)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- PÁGINAS INTERMEDIAS -->
                        @for (int pagina = inicio; pagina <= fin; pagina++)
                        {
                            if (pagina == paginaActual)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @pagina
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListCurso"
                                   asp-controller="CRUDCurso"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-codigoCurso="@Model.CodigoCurso"
                                   asp-route-nombreCurso="@Model.NombreCurso"
                                   asp-route-creditos="@Model.Creditos"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @pagina

                                </a>
                            }
                        }


                        <!-- ... DERECHO -->
                        @if (fin < totalPaginas - 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- ÚLTIMA PÁGINA -->
                        @if (totalPaginas > 1)
                        {
                            if (paginaActual == totalPaginas)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @totalPaginas
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListCurso"
                                   asp-controller="CRUDCurso"
                                   asp-route-pagina="@totalPaginas"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-codigoCurso="@Model.CodigoCurso"
                                   asp-route-nombreCurso="@Model.NombreCurso"
                                   asp-route-creditos="@Model.Creditos"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @totalPaginas

                                </a>
                            }
                        }


                        <!-- SIGUIENTE -->
                        @if (Model.Paginacion.TienePaginaSiguiente)
                        {
                            <a asp-action="ListCurso"
                               asp-controller="CRUDCurso"
                               asp-route-pagina="@(Model.Paginacion.Pagina + 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-codigoCurso="@Model.CodigoCurso"
                               asp-route-nombreCurso="@Model.NombreCurso"
                               asp-route-creditos="@Model.Creditos"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </span>
                        }

                    </div>
                }

            </div>
        </div>
    }

</section>
