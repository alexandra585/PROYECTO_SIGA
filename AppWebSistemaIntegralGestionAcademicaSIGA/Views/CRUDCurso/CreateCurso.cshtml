@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.CursoViewModel

@{
    ViewData["Title"] = "Registrar curso";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-emerald-600 to-blue-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-emerald-100">Gestión de cursos</p>
                <h2 class="mt-2 text-3xl font-extrabold">Registrar curso</h2>
                <p class="mt-3 max-w-2xl text-emerald-100">
                    Registra una nueva asignatura con su código, créditos y distribución de horas académicas.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="book-plus" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Datos del curso</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Completa la información principal para crear el curso en el sistema.
                </p>
            </div>

            <form asp-action="CreateCurso" asp-controller="CRUDCurso" method="post" class="mt-6 space-y-5">
                @Html.AntiForgeryToken()
                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label asp-for="codigoCurso" class="mb-2 block text-sm font-semibold text-slate-700">Código del curso *</label>
                        <div class="relative">
                            <i data-lucide="hash" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="codigoCurso"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: POOI-A01"
                                   required/>
                        </div>
                        <span asp-validation-for="codigoCurso" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="nombreCurso" class="mb-2 block text-sm font-semibold text-slate-700">Nombre del curso *</label>
                        <div class="relative">
                            <i data-lucide="book-open" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="nombreCurso"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: Programación Orientada a Objetos I"
                                   required/>
                        </div>
                        <span asp-validation-for="nombreCurso" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="grid gap-5 md:grid-cols-3">
                    <div>
                        <label asp-for="creditos" class="mb-2 block text-sm font-semibold text-slate-700">Créditos *</label>
                        <div class="relative">
                            <i data-lucide="badge-check" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="creditos"
                                   type="number"
                                   min="1"
                                   max="6"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: 4"
                                   required/>
                        </div>
                        <span asp-validation-for="creditos" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="horasTeoricas" class="mb-2 block text-sm font-semibold text-slate-700">Horas teóricas</label>
                        <div class="relative">
                            <i data-lucide="clock-3" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="horasTeoricas"
                                   type="number"
                                   min="0"
                                   max="10"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: 2"
                                   required/>
                        </div>
                    </div>

                    <div>
                        <label asp-for="horasPracticas" class="mb-2 block text-sm font-semibold text-slate-700">Horas prácticas</label>
                        <div class="relative">
                            <i data-lucide="flask-conical" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="horasPracticas"
                                   type="number"
                                   min="0"
                                   max="10"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: 2"
                                   required/>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-3 pt-3 sm:flex-row sm:justify-end">
                    <a asp-action="ListCurso" asp-controller="CRUDCurso"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                        <i data-lucide="save" class="h-4 w-4"></i>
                        Registrar curso
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <i data-lucide="info" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-slate-950">Información</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    El código del curso debe ser único para evitar duplicados en el sistema.
                </p>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i data-lucide="calculator" class="h-6 w-6"></i>
                </div>

                <h3 class="mt-5 font-bold text-slate-950">Recomendación</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Verifica que los créditos y horas correspondan a la carga académica real del curso.
                </p>
            </div>
        </div>
    </div>
</section>