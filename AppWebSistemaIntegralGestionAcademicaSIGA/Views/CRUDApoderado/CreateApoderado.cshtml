@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.ApoderadoViewModel
@{
    ViewData["Title"] = "Registrar apoderado";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-emerald-600 to-blue-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-blue-100">Gestión de apoderados</p>
                <h2 class="mt-2 text-3xl font-extrabold">Registrar apoderado</h2>
                <p class="mt-3 max-w-2xl text-blue-100">
                    Registra un nuevo apoderado y crea su acceso inicial al sistema académico.
                </p>
            </div>
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="user-plus" class="h-8 w-8"></i>
            </div>
        </div>
    </div>
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
            <div class="border-b border-slate-200 pb-5">
                <h3 class="text-lg font-bold text-slate-950">Datos del nuevo apoderado</h3>
                <p class="mt-1 text-sm text-slate-500">
                    Completa la información personal, contacto y de acceso.
                </p>
            </div>
            <form asp-action="CreateApoderado" asp-controller="CRUDApoderado" method="post" class="mt-6 space-y-5" id="formApoderado">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="id" id="usuarioId" value="0" />

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <p class="mb-3 text-sm font-semibold text-slate-700">¿Cómo deseas registrar al apoderado? Seleccione una opción</p>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <label class="flex flex-1 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-3 hover:border-emerald-400 has-[:checked]:border-emerald-500 has-[:checked]:ring-2 has-[:checked]:ring-emerald-100">
                            <input type="radio" name="modoRegistro" value="nuevo" class="h-4 w-4 text-emerald-600" checked id="modoNuevo" />
                            <div>
                                <p class="text-sm font-bold text-slate-900">Nuevo usuario</p>
                                <p class="text-xs text-slate-500">Ingresar datos en todos los campos solicitados</p>
                            </div>
                        </label>
                        <label class="flex flex-1 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-3 hover:border-emerald-400 has-[:checked]:border-emerald-500 has-[:checked]:ring-2 has-[:checked]:ring-emerald-100">
                            <input type="radio" name="modoRegistro" value="existente" class="h-4 w-4 text-emerald-600" id="modoExistente" />
                            <div>
                                <p class="text-sm font-bold text-slate-900">Usuario existente</p>
                                <p class="text-xs text-slate-500">Seleccionar de la lista</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div id="seccionNuevo">
                    <div class="grid gap-5 md:grid-cols-2">
                        <div>
                            <label asp-for="nombreCompleto" class="mb-2 block text-sm font-semibold text-slate-700">Nombre completo *</label>
                            <div class="relative">
                                <i data-lucide="user-round" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                                <input asp-for="nombreCompleto"
                                       id="inputNombre"
                                       class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                       placeholder="Nombre completo" />
                            </div>
                            <span asp-validation-for="nombreCompleto" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="email" class="mb-2 block text-sm font-semibold text-slate-700">Correo electrónico *</label>
                            <div class="relative">
                                <i data-lucide="mail" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                                <input asp-for="email"
                                       id="inputEmail"
                                       type="email"
                                       class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                       placeholder="correo@ejemplo.com" />
                            </div>
                            <span asp-validation-for="email" class="mt-1 block text-sm text-red-600"></span>
                            <p class="mt-2 flex items-center gap-2 text-xs text-slate-500">
                                <i data-lucide="key-round" class="h-3.5 w-3.5"></i>
                                La contraseña inicial será:
                                <span class="font-bold text-slate-700">123456</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div id="seccionExistente" class="hidden">
                    <div class="mb-4">
                        <label class="mb-2 block text-sm font-semibold text-slate-700">Seleccionar usuario existente *</label>
                        <button type="button"
                                id="btnAbrirModalUsuarios"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-emerald-300 bg-emerald-50 px-5 py-3 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">
                            <i data-lucide="search" class="h-4 w-4"></i>
                            Busque y seleccione el usuario - apoderado a registrar
                        </button>
                        <span class="mt-1 block text-sm text-red-600" id="errorUsuario"></span>
                    </div>
                    <div class="grid gap-5 md:grid-cols-2">
                        <div>
                            <label class="mb-2 block text-sm font-semibold text-slate-700">Nombre completo</label>
                            <div class="relative">
                                <i data-lucide="user-round" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                                <input type="text"
                                       id="nombreUsuarioSeleccionado"
                                       class="w-full rounded-xl border border-slate-300 bg-slate-100 py-3 pl-12 pr-4 text-sm text-slate-700 outline-none"
                                       placeholder="Se completará al seleccionar"
                                       readonly />
                            </div>
                        </div>
                        <div>
                            <label class="mb-2 block text-sm font-semibold text-slate-700">Correo electrónico</label>
                            <div class="relative">
                                <i data-lucide="mail" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                                <input type="text"
                                       id="emailUsuarioSeleccionado"
                                       class="w-full rounded-xl border border-slate-300 bg-slate-100 py-3 pl-12 pr-4 text-sm text-slate-700 outline-none"
                                       placeholder="Se completará al seleccionar"
                                       readonly />
                            </div>
                            <p class="mt-2 flex items-center gap-2 text-xs text-slate-500">
                                <i data-lucide="key-round" class="h-3.5 w-3.5"></i>
                                La contraseña inicial del usuario se mantiene:
                                <span class="font-bold text-slate-700">123456</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label asp-for="dni" class="mb-2 block text-sm font-semibold text-slate-700">DNI *</label>
                        <div class="relative">
                            <i data-lucide="id-card" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="dni"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: 70123456"
                                   maxlength="15" />
                        </div>
                        <span asp-validation-for="dni" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="telefono" class="mb-2 block text-sm font-semibold text-slate-700">Teléfono</label>
                        <div class="relative">
                            <i data-lucide="phone" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                            <input asp-for="telefono"
                                   class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                                   placeholder="Ej: 999888777" />
                        </div>
                        <span asp-validation-for="telefono" class="mt-1 block text-sm text-red-600"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="direccion" class="mb-2 block text-sm font-semibold text-slate-700">Dirección</label>
                    <div class="relative">
                        <i data-lucide="map-pin" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                        <input asp-for="direccion"
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                               placeholder="Ej: Av. Los Olivos 123, Lima" />
                    </div>
                    <span asp-validation-for="direccion" class="mt-1 block text-sm text-red-600"></span>
                </div>

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-700">Estado de cuenta</label>
                    <label class="flex cursor-pointer items-center justify-between rounded-xl border border-slate-300 bg-white px-4 py-3 hover:bg-slate-50">
                        <div class="flex items-center gap-3">
                            <div class="rounded-xl bg-emerald-50 p-2 text-emerald-600">
                                <i data-lucide="power" class="h-5 w-5"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-slate-900">Apoderado activo</p>
                                <p class="text-xs text-slate-500">El apoderado podrá iniciar sesión</p>
                            </div>
                        </div>
                        <input asp-for="activo" class="h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" checked />
                    </label>
                </div>

                <div class="flex flex-col gap-3 pt-3 sm:flex-row sm:justify-end">
                    <a asp-action="ListApoderado" asp-controller="CRUDApoderado"
                       class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-100">
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                        Cancelar
                    </a>
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700">
                        <i data-lucide="save" class="h-4 w-4"></i>
                        Registrar apoderado
                    </button>
                </div>
            </form>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <i data-lucide="info" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 font-bold text-slate-950">Información</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Al registrar un apoderado, se crea su usuario con rol Apoderado dentro del sistema.
                </p>
            </div>
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-50 text-cyan-600">
                    <i data-lucide="key-round" class="h-6 w-6"></i>
                </div>
                <h3 class="mt-5 font-bold text-slate-950">Acceso inicial</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">
                    La contraseña inicial asignada será <strong>123456</strong>. Se recomienda cambiarla posteriormente.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ===================== MODAL ===================== -->
<div id="modalUsuarios" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="flex w-full max-w-3xl flex-col rounded-3xl border border-slate-200 bg-white shadow-2xl" style="height: 580px;">
        <div class="flex shrink-0 items-center justify-between border-b border-slate-200 px-6 py-5">
            <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <i data-lucide="users" class="h-5 w-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-950">Seleccionar usuario - apoderado</h3>
                    <p class="text-sm text-slate-500">Escribe el nombre a registrar para filtrar los usuarios disponibles para apoderado</p>
                </div>
            </div>
            <button type="button" id="btnCerrarModal" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>
        <div class="shrink-0 border-b border-slate-200 px-6 py-4">
            <div class="relative">
                <i data-lucide="search" class="absolute left-4 top-3.5 h-5 w-5 text-slate-400"></i>
                <input type="text"
                       id="inputBusquedaUsuario"
                       class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-12 pr-4 text-sm text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
                       placeholder="Escribe el nombre del usuario"
                       autocomplete="off" />
            </div>
        </div>
        <div class="flex-1 overflow-y-auto px-2 py-3" id="listaUsuarios" style="min-height: 320px;">
            <div class="flex h-full items-center justify-center px-4 py-8 text-center text-sm text-slate-400">
                Escribe el nombre para buscar...
            </div>
        </div>
        <div class="shrink-0 border-t border-slate-200 px-6 py-4 text-right">
            <button type="button"
                    id="btnCancelarModal"
                    class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Cancelar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Apoderado/CreateApoderado.js" asp-append-version="true"></script>
}