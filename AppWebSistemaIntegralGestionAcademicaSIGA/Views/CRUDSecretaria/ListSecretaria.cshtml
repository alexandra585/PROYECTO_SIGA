@model AppWebSistemaIntegralGestionAcademicaSIGA.ENTITY.ViewModels.SecretariaListadoViewModel

@{
    ViewData["Title"] = "Lista de secretarias";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<section class="space-y-6">
    <div class="rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-medium text-violet-100">Gestión administrativa</p>
                <h2 class="mt-2 text-3xl font-extrabold">Gestión de secretarias</h2>
                <p class="mt-3 max-w-2xl text-violet-100">
                    Administra secretarias, cargos, teléfonos y estado de cuenta.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15">
                <i data-lucide="clipboard-list" class="h-8 w-8"></i>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-800">
            <div class="flex items-start gap-3">
                <i data-lucide="check-circle-2" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800">
            <div class="flex items-start gap-3">
                <i data-lucide="triangle-alert" class="mt-0.5 h-5 w-5"></i>
                <p class="text-sm font-semibold">@TempData["Error"]</p>
            </div>
        </div>
    }

<!-- ========================= -->
<!-- RESUMEN -->
<!-- ========================= -->

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="grid w-full gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Activas</p>
                <h3 class="mt-2 text-3xl font-extrabold text-emerald-600">@Model.Secretarias.Count(s => s.activo)</h3>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-sm text-slate-500">Inactivas</p>
                <h3 class="mt-2 text-3xl font-extrabold text-red-600">@Model.Secretarias.Count(s => !s.activo)</h3>
            </div>
        </div>
    </div>

<!-- ========================= -->
<!-- BOTÓN NUEVA SECRETARIA -->
<!-- ========================= -->

    <div class="flex justify-end">
        <a asp-action="CreateSecretaria" asp-controller="CRUDSecretaria"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nueva secretaria
        </a>
    </div>

<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->

<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

    <div class="mb-5">
        <h3 class="text-lg font-bold text-slate-950">
            Buscar secretarias
        </h3>

        <p class="mt-1 text-sm text-slate-500">
            Utiliza los filtros para encontrar una secretaria específica.
        </p>
    </div>

    <form asp-action="ListSecretaria"
          asp-controller="CRUDSecretaria"
          method="get">

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">

            <!-- Nombre -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Nombre
                </label>

                <input type="text"
                       name="nombre"
                       value="@Model.Nombre"
                       placeholder="Buscar por nombre..."
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" />
            </div>


            <!-- Email -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Correo
                </label>

                <input type="text"
                       name="email"
                       value="@Model.Email"
                       placeholder="Buscar por correo..."
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" />
            </div>


            <!-- Cargo -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Cargo
                </label>

                <input type="text"
                       name="cargo"
                       value="@Model.Cargo"
                       placeholder="Buscar por cargo..."
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" />
            </div>


            <!-- Teléfono -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Teléfono
                </label>

                <input type="text"
                       name="telefono"
                       value="@Model.Telefono"
                       placeholder="Buscar por teléfono..."
                       class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" />
            </div>

        </div>


        <div class="mt-4 grid gap-4 md:grid-cols-2">

            <!-- Estado -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Estado
                </label>

                <select name="activo"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100">

                    @if (Model.Activo == true)
                    {
                        <option value="true" selected>Activas</option>
                    }
                    else
                    {
                        <option value="true">Activas</option>
                    }

                    @if (Model.Activo == false)
                    {
                        <option value="false" selected>Inactivas</option>
                    }
                    else
                    {
                        <option value="false">Inactivas</option>
                    }

                    @if (Model.Activo == null)
                    {
                        <option value="" selected>Todas</option>
                    }
                    else
                    {
                        <option value="">Todas</option>
                    }

                </select>
            </div>


            <!-- Tamaño página -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Registros por página
                </label>

                <select name="tamanioPagina"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100">

                    @if (Model.Paginacion.TamanioPagina == 5)
                    {
                        <option value="5" selected>5</option>
                    }
                    else
                    {
                        <option value="5">5</option>
                    }

                    @if (Model.Paginacion.TamanioPagina == 10)
                    {
                        <option value="10" selected>10</option>
                    }
                    else
                    {
                        <option value="10">10</option>
                    }

                    @if (Model.Paginacion.TamanioPagina == 20)
                    {
                        <option value="20" selected>20</option>
                    }
                    else
                    {
                        <option value="20">20</option>
                    }

                    @if (Model.Paginacion.TamanioPagina == 50)
                    {
                        <option value="50" selected>50</option>
                    }
                    else
                    {
                        <option value="50">50</option>
                    }

                </select>
            </div>

        </div>


        <!-- BOTONES -->

        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:justify-end">

            <a asp-action="ListSecretaria"
               asp-controller="CRUDSecretaria"
               class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">

                <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
                Limpiar filtros

            </a>

            <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">

                <i data-lucide="search" class="h-4 w-4"></i>
                Buscar

            </button>

        </div>

    </form>

</div>

<!-- ========================= -->
<!-- LISTADO -->
<!-- ========================= -->
@if (!Model.Secretarias.Any())
{
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-800">

        <div class="flex items-start gap-4">

            <i data-lucide="info" class="mt-0.5 h-6 w-6"></i>

            <div>

                <h3 class="font-bold">
                    No hay secretarias registradas
                </h3>

                <p class="mt-1 text-sm">
                    No se encontraron secretarias con los filtros seleccionados.
                </p>

            </div>

        </div>

    </div>

}
else
{

    <div class="rounded-3xl border border-slate-200 bg-white shadow-sm">

        <!-- ENCABEZADO -->

        <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

            <div>

                <h3 class="text-lg font-bold text-slate-950">
                    Listado de secretarias
                </h3>

                <p class="mt-1 text-sm text-slate-500">
                    Consulta y administra secretarias registradas.
                </p>

            </div>

            <span class="inline-flex w-fit items-center gap-2 rounded-full bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-700">

                <i data-lucide="users" class="h-4 w-4"></i>

                @Model.Paginacion.TotalRegistros
                secretarias

            </span>

        </div>


        <!-- TABLA -->

        <div class="overflow-x-auto">

            <table class="w-full min-w-[1000px] text-left text-sm">

                <thead>

                    <tr class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">

                        <th class="px-6 py-4 font-bold">
                            Secretaria
                        </th>

                        <th class="px-6 py-4 font-bold">
                            Correo
                        </th>

                        <th class="px-6 py-4 font-bold">
                            Cargo
                        </th>

                        <th class="px-6 py-4 font-bold">
                            Teléfono
                        </th>

                        <th class="px-6 py-4 font-bold">
                            Estado
                        </th>

                        <th class="px-6 py-4 text-right font-bold">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-slate-100">

                    @foreach (var secretaria in Model.Secretarias)
                    {
                        <tr class="transition hover:bg-slate-50">

                            <td class="px-6 py-5">

                                <div class="flex items-center gap-3">

                                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">

                                        <i data-lucide="clipboard-list"
                                           class="h-5 w-5"></i>

                                    </div>

                                    <div>

                                        <p class="font-bold text-slate-950">
                                            @secretaria.nombreCompleto
                                        </p>

                                        <p class="mt-1 text-xs text-slate-500">
                                            ID: @secretaria.id
                                        </p>

                                    </div>

                                </div>

                            </td>


                            <td class="px-6 py-5 text-slate-600">

                                <div class="flex items-center gap-2">

                                    <i data-lucide="mail"
                                       class="h-4 w-4 text-slate-400"></i>

                                    @secretaria.email

                                </div>

                            </td>


                            <td class="px-6 py-5">

                                <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">

                                    @(string.IsNullOrWhiteSpace(secretaria.cargo)
                                        ? "Sin cargo"
                                        : secretaria.cargo)

                                </span>

                            </td>


                            <td class="px-6 py-5 text-slate-600">

                                <div class="flex items-center gap-2">

                                    <i data-lucide="phone"
                                       class="h-4 w-4 text-slate-400"></i>

                                    @(string.IsNullOrWhiteSpace(secretaria.telefono)
                                        ? "—"
                                        : secretaria.telefono)

                                </div>

                            </td>


                            <td class="px-6 py-5">

                                @if (secretaria.activo)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">

                                        <i data-lucide="check-circle-2"
                                           class="h-3.5 w-3.5"></i>

                                        Activo

                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">

                                        <i data-lucide="x-circle"
                                           class="h-3.5 w-3.5"></i>

                                        Inactivo

                                    </span>
                                }

                            </td>


                            <td class="px-6 py-5">

                                <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">

                                    <a asp-action="EditSecretaria"
                                       asp-controller="CRUDSecretaria"
                                       asp-route-id="@secretaria.id"
                                       class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600">

                                        <i data-lucide="edit-3"
                                           class="h-4 w-4"></i>

                                        Editar

                                    </a>

                                    <a asp-action="DeleteSecretaria"
                                       asp-controller="CRUDSecretaria"
                                       asp-route-id="@secretaria.id"
                                       class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">

                                        <i data-lucide="trash-2"
                                           class="h-4 w-4"></i>

                                        Eliminar

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- ========================= -->
        <!-- PAGINACIÓN -->
        <!-- ========================= -->
            <div class="flex flex-col gap-4 border-t border-slate-200 px-6 py-5 md:flex-row md:items-center md:justify-between">

                <!-- Información -->
                <div class="text-sm text-slate-500">

                    @if (Model.Paginacion.TotalRegistros > 0)
                    {
                        var primerRegistro =
                            ((Model.Paginacion.Pagina - 1)
                            * Model.Paginacion.TamanioPagina) + 1;

                        var ultimoRegistro =
                            Math.Min(
                                Model.Paginacion.Pagina
                                * Model.Paginacion.TamanioPagina,
                                Model.Paginacion.TotalRegistros
                            );

                        <span>
                            Mostrando
                            <span class="font-semibold text-slate-700">
                                @primerRegistro
                            </span>
                            -
                            <span class="font-semibold text-slate-700">
                                @ultimoRegistro
                            </span>
                            de
                            <span class="font-semibold text-slate-700">
                                @Model.Paginacion.TotalRegistros
                            </span>
                            registros
                        </span>
                    }
                    else
                    {
                        <span>No hay registros</span>
                    }

                </div>


                <!-- Botones -->
                @if (Model.Paginacion.TotalPaginas > 1)
                {
                    <div class="flex items-center gap-1">

                        <!-- ANTERIOR -->
                        @if (Model.Paginacion.TienePaginaAnterior)
                        {
                            <a asp-action="ListSecretaria"
                               asp-controller="CRUDSecretaria"
                               asp-route-pagina="@(Model.Paginacion.Pagina - 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-cargo="@Model.Cargo"
                               asp-route-telefono="@Model.Telefono"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <i data-lucide="chevron-left" class="h-4 w-4"></i>

                                <span class="hidden sm:inline">Anterior</span>
                            </span>
                        }


                        <!-- PRIMERA PÁGINA -->
                        @if (Model.Paginacion.Pagina == 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                1
                            </span>
                        }
                        else
                        {
                            <a asp-action="ListSecretaria"
                               asp-controller="CRUDSecretaria"
                               asp-route-pagina="1"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-cargo="@Model.Cargo"
                               asp-route-telefono="@Model.Telefono"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">
                                1
                            </a>
                        }


                        @{
                            int paginaActual = Model.Paginacion.Pagina;
                            int totalPaginas = Model.Paginacion.TotalPaginas;

                            // Mostrar páginas cercanas a la actual
                            int inicio = Math.Max(2, paginaActual - 1);
                            int fin = Math.Min(totalPaginas - 1, paginaActual + 1);
                        }


                        <!-- ... IZQUIERDO -->
                        @if (inicio > 2)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- PÁGINAS INTERMEDIAS -->
                        @for (int pagina = inicio; pagina <= fin; pagina++)
                        {
                            if (pagina == paginaActual)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @pagina
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListSecretaria"
                                   asp-controller="CRUDSecretaria"
                                   asp-route-pagina="@pagina"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-cargo="@Model.Cargo"
                                   asp-route-telefono="@Model.Telefono"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @pagina

                                </a>
                            }
                        }


                        <!-- ... DERECHO -->
                        @if (fin < totalPaginas - 1)
                        {
                            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400">
                                ...
                            </span>
                        }


                        <!-- ÚLTIMA PÁGINA -->
                        @if (totalPaginas > 1)
                        {
                            if (paginaActual == totalPaginas)
                            {
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-sm font-semibold text-white">
                                    @totalPaginas
                                </span>
                            }
                            else
                            {
                                <a asp-action="ListSecretaria"
                                   asp-controller="CRUDSecretaria"
                                   asp-route-pagina="@totalPaginas"
                                   asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                                   asp-route-nombre="@Model.Nombre"
                                   asp-route-email="@Model.Email"
                                   asp-route-cargo="@Model.Cargo"
                                   asp-route-telefono="@Model.Telefono"
                                   asp-route-activo="@Model.Activo"
                                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                    @totalPaginas

                                </a>
                            }
                        }


                        <!-- SIGUIENTE -->
                        @if (Model.Paginacion.TienePaginaSiguiente)
                        {
                            <a asp-action="ListSecretaria"
                               asp-controller="CRUDSecretaria"
                               asp-route-pagina="@(Model.Paginacion.Pagina + 1)"
                               asp-route-tamanioPagina="@Model.Paginacion.TamanioPagina"
                               asp-route-nombre="@Model.Nombre"
                               asp-route-email="@Model.Email"
                               asp-route-cargo="@Model.Cargo"
                               asp-route-telefono="@Model.Telefono"
                               asp-route-activo="@Model.Activo"
                               class="inline-flex h-9 items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex h-9 cursor-not-allowed items-center justify-center gap-1 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-300">

                                <span class="hidden sm:inline">Siguiente</span>

                                <i data-lucide="chevron-right" class="h-4 w-4"></i>
                            </span>
                        }

                    </div>
                }

            </div>
    </div>

}
